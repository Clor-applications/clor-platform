{
  "appId": "in.clor.attendance",
  "appName": "CLOR Attendance",
  "webDir": "../../dist-mobile/attendance",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FFFFFF",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#FFFFFF",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FFFFFF"
    }
  }
}
