# Cloudflare Pages response headers for the web app (app., accounting.,
# attendance., payroll.clor.in). The API sets its own through helmet.
#
# Content-Security-Policy is enforced (it was Report-Only until 12 Nov 2026:
# the platform audit of 11 Nov found the access token one injected script away
# from theft). The sha256 is the inline host-picker script in index.html;
# test/security-headers.test.js fails if the two drift. The same file serves
# the staging app, hence its API address. blob: frames are the document and
# PDF previews; a new outside address (a map, a font, an upload host) must be
# added here or the browser refuses it. cloudflareinsights.com is the Web
# Analytics beacon Cloudflare injects into every page (same as clor.in).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-fbXqAf46mO44PEbf425r520BwT9XING4lMcEp8RIHiA=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://api.clor.in https://api.staging.clor.in https://cloudflareinsights.com; frame-src 'self' blob:; media-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Built files carry a content hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
