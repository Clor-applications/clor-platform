# Plain (non-secret) settings of the production API on AWS. The secret ones
# (DB_PASSWORD, JWT_SECRET, MAIL_SECRET_KEY, EDGE_SECRET, JOBS_TOKEN, SMTP_USER,
# SMTP_PASS, CLOR_OPERATOR_USER_IDS, DB_HOST and any other) live in AWS
# Parameter Store under /clor/prod/ and reach the container as secrets.env.
# Copied from deploy/cloudrun.service.yaml; change both while both are alive.
NODE_ENV=production
PORT=8080

# The database: one RDS instance, four databases, one password.
DB_USER=clor_app
# Connections per database. RDS db.t4g.small allows about 220; this is 30,
# against 14 on Cloud SQL's smallest tier, where a Home page's 15-20 parallel
# requests queued (server/scripts/cloudrun-start.sh).
DB_POOL_MAIN=8
DB_POOL_PLATFORM=8
DB_POOL_PEOPLE=10
DB_POOL_PAYROLL=4

JWT_ISSUER=clor
JWT_AUDIENCE=clor

CORS_ORIGIN=https://app.clor.in,https://books.clor.in,https://accounting.clor.in,https://payroll.clor.in,https://attendance.clor.in,https://localhost,capacitor://localhost,https://people.clor.in,https://ops.clor.in
APP_URL=https://app.clor.in
PORTAL_URL=https://attendance.clor.in/#/portal
API_PUBLIC_URL=https://api.clor.in
APP_NAME=Clor

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=Clor <no-reply@clor.in>
