generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------
// Warehouses
// ----------------------------
model Warehouse {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  code      String

  name                String
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  country             String?
  gstin               String?
  gstRegistrationType String  @default("UNREGISTERED")
  contactPerson       String?
  phone               String?
  email               String?
  isActive            Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stock  StockBalance[]

  transferLines InterBranchTransferLine[]

  transfersOut InterBranchTransfer[] @relation("WarehouseOut")
  transfersIn  InterBranchTransfer[] @relation("WarehouseIn")

  @@unique([orgId, branchId, name])
  @@unique([orgId, code])
  @@index([accountId, orgId, branchId])
}

// ----------------------------
// Inventory + inter-branch transfer
// ----------------------------
model Item {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  // branchId allows branch-specific master overrides; for shared masters use null
  branchId  String?

  sku      String
  name     String
  unit     String
  isActive Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stockBalances StockBalance[]
  transferLines InterBranchTransferLine[]

  @@unique([orgId, branchId, sku])
  @@index([accountId, orgId])
}

model StockBalance {
  id          String @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String
  itemId      String

  qtyOnHand Decimal @default(0)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([orgId, branchId, warehouseId, itemId])
  @@index([accountId, orgId, branchId, warehouseId])
}

model InterBranchTransfer {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  branchId          String // source context for isolation
  sourceBranchId    String
  sourceWarehouseId String
  targetBranchId    String
  targetWarehouseId String

  transferNo String
  status     String @default("DRAFT") // DRAFT | SENT | RECEIVED | REJECTED

  initiatedByUserId String
  approvedByUserId  String?
  rejectedReason    String?

  sentAt     DateTime?
  receivedAt DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceWarehouse Warehouse @relation("WarehouseOut", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse @relation("WarehouseIn", fields: [targetWarehouseId], references: [id])

  lines InterBranchTransferLine[]

  @@unique([orgId, transferNo])
  @@index([accountId, orgId, sourceBranchId])
  @@index([accountId, orgId, targetBranchId])
}

model InterBranchTransferLine {
  id          String @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String

  transferId String
  itemId     String
  qty        Decimal

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transfer  InterBranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item      Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([accountId, orgId, transferId])
}

model InventoryAdjustment {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String
  itemId      String
  qtyDelta    Decimal
  reason      String

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId, branchId, warehouseId, itemId])
}

/// Every change to a bank date, on any movement the reconciliation screen
/// confirms: a payment or receipt, a bank-statement line, or a contra.
///
/// A bank date is a claim about the bank's records; one somebody changed must
/// say from what, to what, by whom and when. This used to live only in the
/// browser, so the history was gone on the next reload. Written by the server
/// in the same transaction as the reconcile itself, so the two cannot differ.
model BankDateAudit {
  id               String   @id @default(cuid())
  accountId        String
  orgId            String
  kind             String // PAYMENT | STATEMENT | CONTRA
  sourceId         String // the Payment, BankBookEntry or JournalEntry id
  voucherNo        String?
  ledgerAccountId  String?
  transactionDate  String
  previousBankDate String?
  bankDate         String?
  action           String // RECONCILED | UNRECONCILED | REDATED
  statementRef     String?
  byUserId         String
  at               DateTime @default(now())

  @@index([accountId, orgId, kind, sourceId])
  @@index([accountId, orgId, at])
}

/// A stock document the browser raised — an adjustment or an inter-branch
/// transfer — kept on the server so every device and user sees one set.
///
/// Every quantity that moved, one row per document line.
///
/// Written by database triggers (migration 20260930090000_stock_ledger)
/// whenever an invoice, bill, credit note, debit note, stock document or item
/// is written, from that row's own content — so no route, import, script or
/// recurring run can move stock without it landing here, and a document's
/// rows are always exactly what the document now says. Never written by the
/// application.
///
/// `qty` is signed: in is positive, out negative. On hand for an item in a
/// warehouse is the sum of its rows there, plus rows that name no warehouse
/// (see services/stockLedger.ts onHand). Only STOCK items count;
/// that is decided when reading, so changing an item's type needs no rebuild.
model StockMovement {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId   String
  orgId       String
  branchId    String?
  warehouseId String?
  itemId      String
  date        String
  qty         Decimal
  /// OPENING | INVOICE | BILL | CREDIT_NOTE | DEBIT_NOTE | ADJUSTMENT | TRANSFER
  sourceKind  String
  sourceId    String
  sourceNo    String?
  lineNo      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([orgId, itemId, warehouseId])
  @@index([sourceKind, sourceId])
}

/// The browser still computes stock from its documents, as it does from
/// invoices and bills; this table makes those documents shared and durable.
/// Identity across devices is `uid` (local ids do not travel). The columns are
/// what the server checks — date against closed periods, warehouses against
/// access — and `payloadJson` is the record as the screen keeps it.
/// There is deliberately no stock balance here: the server does not yet see
/// the invoices and bills that move stock, and a partial balance would lie.
model StockDocument {
  id                String  @id @default(cuid())
  accountId         String
  orgId             String
  kind              String // ADJUSTMENT | TRANSFER
  uid               String
  number            String?
  date              String // ISO date the stock moved
  status            String?
  branchId          String?
  warehouseId       String?
  targetBranchId    String?
  targetWarehouseId String?
  payloadJson       String

  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, kind, uid])
  @@index([accountId, orgId, kind])
}

// ----------------------------
// Sales invoices
// ----------------------------
model Invoice {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  warehouseId String?
  number      String
  date        String
  dueDate     String?
  refNo       String?
  refDate     String?

  customerId         String?
  customerName       String
  customerGstin      String?
  placeOfSupplyState String?
  taxType            String?
  // GSTR-1 rchrg flag: supply attracts reverse charge (buyer pays the tax).
  reverseCharge      Boolean @default(false)

  // Fields the entry forms collect that have no column of their own —
  // salesman, cost centre, invoice-level discount, other charges, ship-to,
  // the document this was raised from, POS details. They were being dropped on
  // the way to the server, so a browser that had never seen the invoice
  // rebuilt it without them. Stored as JSON so new UI fields do not each need
  // a migration.
  extrasJson String?

  subtotal   Decimal @default(0)
  cgstTotal  Decimal @default(0)
  sgstTotal  Decimal @default(0)
  igstTotal  Decimal @default(0)
  gstTotal   Decimal @default(0)
  total      Decimal @default(0)
  paidAmount Decimal @default(0)

  status           String  @default("Draft")
  sourceEstimateId String?
  itemsJson        String

  /// The currency this invoice was raised in, and the rate used to translate
  /// it into the books. Both are stored so the posting can be explained later
  /// without guessing which rate was in force.
  currency     String  @default("INR")
  exchangeRate Decimal @default(1)
  /// `total` translated at `exchangeRate`. Reports read this.
  baseTotal    Decimal @default(0)

  /// Migration identity: where this row came from, and its key in that system.
  /// Re-running an import maps to the same row instead of duplicating it.
  sourceSystem String?
  sourceKey    String?

  /// e-Invoice (IRP) registration result. IRN is the invoice's identity on
  /// the GST network; the signed QR must be printed on the document.
  irn                 String?
  irnStatus           String? // REGISTERED | FAILED | CANCELLED
  irnAckNo            String?
  irnAckDate          String?
  irnSignedQr         String?
  /// The full SignedInvoice JWT the IRP returns — the legal e-invoice.
  irnSignedInvoice    String?
  /// The INV-01 JSON that was registered, kept verbatim for audit/re-download.
  einvoicePayloadJson String?
  irnError            String?
  irnRegisteredAt     DateTime?
  irnCancelledAt      DateTime?
  irnCancelReason     String?

  /// e-Way Bill generated from the IRN (NIC /eiewb API).
  ewbNo        String?
  ewbDate      String?
  ewbValidTill String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Document numbers are unique across the whole organisation, not within a
  // branch. Scoped per branch, two branches could each issue INV-1 — two
  // different documents wearing one number, which is not a numbering series a
  // business can file, quote in a return, or hand an auditor.
  @@unique([orgId, number])
  @@unique([orgId, sourceSystem, sourceKey])
  @@index([accountId, orgId, branchId, date])
}

/// A purchase bill from a vendor. The mirror of Invoice: it debits purchases and input GST, and credits the vendor.
model Bill {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  warehouseId String?
  number      String
  date        String
  dueDate     String?
  refNo       String?
  refDate     String?

  /// The invoice or bill this note is raised against, when there is one.
  againstDocId String?

  partyId            String?
  partyName          String
  partyGstin         String?
  placeOfSupplyState String?
  taxType            String?

  subtotal      Decimal @default(0)
  cgstTotal     Decimal @default(0)
  sgstTotal     Decimal @default(0)
  igstTotal     Decimal @default(0)
  gstTotal      Decimal @default(0)
  total         Decimal @default(0)
  settledAmount Decimal @default(0)

  status     String  @default("Draft")
  itemsJson  String
  /// Form-collected fields with no column of their own (see Invoice.extrasJson).
  extrasJson String?

  /// Same single-currency rule as invoices: the books are kept in the base
  /// currency, and this is the rate the document was translated at.
  currency     String  @default("INR")
  exchangeRate Decimal @default(1)
  baseTotal    Decimal @default(0)

  sourceSystem String?
  sourceKey    String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Document numbers are unique across the whole organisation, not within a
  // branch. Scoped per branch, two branches could each issue INV-1 — two
  // different documents wearing one number, which is not a numbering series a
  // business can file, quote in a return, or hand an auditor.
  @@unique([orgId, number])
  @@unique([orgId, sourceSystem, sourceKey])
  @@index([accountId, orgId, branchId, date])
}

/// A quotation to a customer. No ledger impact until it becomes an invoice.
model Estimate {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  number     String
  date       String
  validUntil String?
  partyId    String?
  partyName  String
  partyGstin String?

  subtotal Decimal @default(0)
  gstTotal Decimal @default(0)
  total    Decimal @default(0)

  status     String  @default("Draft")
  itemsJson  String
  /// Form-collected fields with no column of their own (see Invoice.extrasJson).
  extrasJson String?
  notes      String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Document numbers are unique across the whole organisation, not within a
  // branch. Scoped per branch, two branches could each issue INV-1 — two
  // different documents wearing one number, which is not a numbering series a
  // business can file, quote in a return, or hand an auditor.
  @@unique([orgId, number])
  @@index([accountId, orgId, branchId, date])
}

