// ============================================================================
// Clor Platform — its own database
// ============================================================================
//
// Who can sign in, which company they belong to, and what they are allowed to
// do. Accounts, orgs, branches, users, sessions, roles, permissions, the audit
// trail, entitlements and the auth/email plumbing all live here — the control
// plane every accounting query assumes but none of them owns.
//
// Why a boundary rather than forty more tables next to Invoice. The platform is
// the part that is shared by everything and changes on its own rhythm: a user
// is invited once and reads a ledger for years, a session is minted and revoked
// far more often than a journal is posted, and an auth policy is a security
// concern with its own retention. Keeping it in its own database means it can
// be backed up, migrated and reasoned about without touching an accounting
// query, and an accidental join from a sales report into a password hash cannot
// be written because the two are not in the same database.
//
// How it stays connected. Accounting holds the platform's identifiers —
// `accountId`, `orgId`, `branchId`, `userId`, `warehouseId` — as plain strings,
// with no cross-database foreign keys, because there is no such thing.
// Referential integrity across the boundary is the application's job and is
// enforced where the two meet.
//
// The one honest cost. A write cannot span both databases in a single
// transaction, so anything that touches platform and accounting together is two
// steps, each idempotent, in an order a crash in between can recover from.

generator platformClient {
  provider = "prisma-client-js"
  output   = "../../src/generated/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

// ----------------------------
// Core tenancy
// ----------------------------
model Account {
  id                   String    @id @default(cuid())
  name                 String
  /// Client ID shown to people: the code of the account's first company (4831920657). Never changed (services/displayCodes.ts).
  code                 String?   @unique
  /// The code it had under the first scheme (KAVE-C100), still found so old links work.
  legacyCode           String?   @unique
  /// Set only by the rollout migration for accounts that predate explicit
  /// subscriptions. A missing subscription is open only when this marker is
  /// present; newly created/unrecognised accounts fail closed.
  legacyUnrestrictedAt DateTime?
  /// Set by a Clor operator (W-8.2): every company in the account refuses work until reinstated.
  suspendedAt          DateTime?
  suspendedReason      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orgs  Org[]
  users User[]

  entitlement AccountEntitlement?
}

model Org {
  id         String  @id @default(cuid())
  accountId  String
  name       String
  /// The public handle: the `agc` in agc.books.clor.in. Separate from `id`
  /// on purpose — the id is what foreign keys and authorisation use and never
  /// changes, the slug is what a person reads and may one day need to change.
  /// Nullable so existing rows are valid before the backfill.
  slug       String? @unique
  /// Company code: ten random digits, the last a check digit (4831920657). In the address (/o/<code>/). Never changed.
  code       String? @unique
  /// No longer issued; kept for rows numbered under the first scheme.
  codeNumber Int?
  /// The code it had under the first scheme (KAVE-C100), still found so old links work.
  legacyCode String? @unique
  /// Archived (services/companyArchive.ts): read-only, out of the switcher's main list and the plan's company count, reversible.
  archivedAt       DateTime?
  archivedReason   String?
  archivedNote     String?
  archivedByUserId String?
  legalName  String?
  pan        String?

  /// The currency the books are kept in. Every ledger posting is in this
  /// currency, whatever currency the document was raised in.
  baseCurrency String @default("INR")

  /// The rest of the company master, as JSON.
  ///
  /// Trade name, entity type, industries, the financial year, the contact
  /// details and the registered address. A column each would be a dozen more
  /// nullable columns nothing queries or reports on — these are read as a whole
  /// on one screen and written as a whole from one form. Anything that later
  /// needs filtering or a report earns its own column then.
  profileJson String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("OrgCreatedBy", fields: [createdByUserId], references: [id])

  branches Branch[]
  roles    Role[]
  members  UserOrgMembership[]
  audit    AuditLog[]

  @@unique([accountId, name])
  @@index([accountId])
}

model Branch {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  branchCode   String
  branchName   String
  addressLine1 String
  addressLine2 String?
  city         String?
  state        String
  country      String

  gstin               String?
  // Stored as a string rather than a Postgres enum: adding a value to an enum
  // is a migration, and these lists grow. (REGULAR | COMPOSITION | UNREGISTERED)
  gstRegistrationType String  @default("UNREGISTERED")
  phone               String?
  email               String?
  contactPerson       String?
  /// Branch status (developer change 9 Oct 2026): inactive branches stay for history but take no new work.
  isActive            Boolean @default(true)

  parentBranchId          String?
  shareHeadOfficeSettings Boolean @default(false)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Branch?  @relation("BranchParent", fields: [parentBranchId], references: [id])
  children Branch[] @relation("BranchParent")

  createdBy User @relation("BranchCreatedBy", fields: [createdByUserId], references: [id])

  users UserBranchMembership[]

  @@unique([orgId, branchCode])
  @@index([accountId, orgId])
}

// ----------------------------
// Users + access
// ----------------------------
model User {
  id        String @id @default(cuid())
  accountId String

  username     String? // optional username login
  /// User ID: ten random digits, the last a check digit. One per person, the same in every company they join.
  code         String? @unique
  /// No longer issued; kept for rows numbered under the first scheme.
  codeNumber   Int?
  /// The ID they had under the first scheme (KAVE-C100-U01).
  legacyCode   String? @unique
  email        String // primary login
  fullName     String
  passwordHash String
  isActive     Boolean @default(true)
  /// Marked as left (services/leavers.ts): when, why, by whom, last working day. Sign-in is off (isActive false); history keeps their name.
  leftAt         DateTime?
  leftReason     String?
  leftNote       String?
  lastWorkingDay String?
  leftByUserId   String?
  /// Their address before it was released for a successor (email then holds a placeholder).
  releasedEmail  String?

  // Profile. `fullName` stays the single source for display so every existing
  // reader keeps working; first and last are what the user actually edits and
  // fullName is recomposed from them on save.
  firstName String?
  lastName  String?
  phone     String?

  // A square image the user picked, resized client-side and stored as a data
  // URL. Capped well under a megabyte by the route. This avoids standing up
  // object storage for something that is a few kilobytes per user, and it
  // keeps working on an install with no network egress.
  avatarUrl String?

  // Authenticator app (TOTP, RFC 6238). The secret is encrypted at rest;
  // enabled only once a code from it has been checked. The last time step
  // used stops a code being replayed; recovery codes are stored hashed.
  totpSecretEnc    String?
  totpEnabledAt    DateTime?
  totpLastStep     Int?
  totpRecoveryJson String?

  // Lockout state. Cleared on a successful sign-in.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  emailVerifiedAt  DateTime?

  /// Which privacy notice and terms the person was shown at sign-up, and
  /// when they went ahead — so consent can be shown, not just asserted.
  noticeVersion    String?
  noticeAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  orgMemberships    UserOrgMembership[]
  branchMemberships UserBranchMembership[]
  roleAssignments   UserRoleAssignment[]
  warehouseAccess   UserWarehouseAccess[]

  createdOrgs     Org[]    @relation("OrgCreatedBy")
  createdBranches Branch[] @relation("BranchCreatedBy")


  /// Globally unique, not per account. Login resolves a user by email across
  /// every account, so two accounts sharing one would make it non-deterministic
  /// — and a person invited into a second company must be the SAME login, not a
  /// second identity with the same address. The route already refused a
  /// duplicate; this makes it structural rather than a rule one handler happens
  /// to keep.
  @@unique([email])
  @@index([accountId])

  platformOperator PlatformOperator?
}

model UserOrgMembership {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  userId    String

  createdAt DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, userId])
  @@index([accountId, orgId])
}

model UserBranchMembership {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String
  userId    String

  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, userId])
  @@index([accountId, orgId, branchId])
}

model UserWarehouseAccess {
  id          String @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String
  userId      String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, warehouseId, userId])
  @@index([accountId, orgId, branchId, warehouseId])
}

// ----------------------------
// Roles + permissions
// ----------------------------
model Role {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  // Optional: branch-scoped custom role
  branchId  String?

  name             String
  description      String?
  // Stored as a string rather than a Postgres enum: adding a value to an enum
  // is a migration, and these lists grow. (ADMIN | ACCOUNTANT | SALES | CUSTOM)
  roleType         String
  // Limits list and single-document reads to rows the holder created
  // (Odoo "Own Documents Only"). One unrestricted role lifts it.
  ownDocumentsOnly Boolean @default(false)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([orgId, branchId, name])
  @@index([accountId, orgId])
}

model Permission {
  id        String  @id @default(cuid())
  module    String
  subModule String?
  // Stored as a string rather than a Postgres enum: adding a value to an enum
  // is a migration, and these lists grow. (VIEW | CREATE | EDIT | DELETE | APPROVE | EXPORT)
  action    String

  rolePermissions RolePermission[]

  @@unique([module, subModule, action])
}

model RolePermission {
  id           String  @id @default(cuid())
  accountId    String
  orgId        String
  roleId       String
  permissionId String
  allowed      Boolean @default(true)
  // Field-level access, as in ERPNext's permlevels. Level 0 covers ordinary
  // fields; a field declared at level 1 needs a rule granting level >= 1.
  permLevel    Int     @default(0)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([accountId, orgId])
}

// Role assignment per org and optionally per branch.
// If branchId is null => org-wide role.
model UserRoleAssignment {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  branchId  String?
  userId    String
  roleId    String

  createdByUserId String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, userId, roleId])
  @@index([accountId, orgId, branchId])
}

// ----------------------------
// Audit log
// ----------------------------
model AuditLog {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  entity   String
  entityId String
  action   String
  message  String?
  // SQLite-compatible: store JSON metadata as string (optional)
  metadata String?

  /// A CLOR user id, or `portal:<employeeId>`, `system`, `api:<client>` (no foreign key: see migration 20261028090000).
  createdByUserId String
  createdAt       DateTime @default(now())
  /// The request id (X-Request-Id) that wrote it; People's change log shares it (D-V8).
  correlationId   String?

  org       Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([accountId, orgId, branchId])
  @@index([orgId, entityId])
}

/// Product telemetry, written on the server only (PRODUCT-VIEW §7): what a
/// company did, never what a person typed. Append-only, like AuditLog
/// (migration 20261031090100); no third-party tracker sees any of it.
model ProductEvent {
  id        String   @id @default(cuid())
  accountId String?
  orgId     String
  /// A CLOR user id, `portal:<employeeId>` or `system`.
  userId    String?
  /// The acting user's first role name, as it was then.
  userRole  String?
  app       String?
  name      String
  /// JSON object, small: counts, sources, steps; never names or personal data.
  props     String?
  createdAt DateTime @default(now())

  @@index([orgId, name, createdAt])
  @@index([name, createdAt])
}

// ----------------------------
// Role profiles — bundles of roles, assigned as one unit
// ----------------------------
model RoleProfile {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  description String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles       RoleProfileRole[]
  assignments UserRoleProfile[]

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

model RoleProfileRole {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  profileId String
  roleId    String

  profile RoleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, roleId])
  @@index([accountId, orgId])
}

model UserRoleProfile {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  profileId String
  branchId  String?

  createdByUserId String
  createdAt       DateTime @default(now())

  profile RoleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, userId, profileId])
  @@index([accountId, orgId, userId])
}

// ----------------------------
// User permissions — document-level restrictions, generalised
// ----------------------------
// Branch and warehouse access already have dedicated tables because they are
// also the tenancy boundary. This covers everything else: restrict a user to
// certain customers, vendors, cost centres, and so on.
model UserPermission {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  userId    String

  entityType String // CUSTOMER | VENDOR | COST_CENTRE | ITEM_GROUP
  entityId   String
  label      String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([accountId, orgId, userId, entityType, entityId])
  @@index([accountId, orgId, userId, entityType])
}

// ----------------------------
// Feature toggles, per organisation
// ----------------------------
/// Which plan an account is on, and anything sold to it beyond the plan.
///
/// Only the assignment is data; the plans themselves live in planCatalog.ts,
/// because a plan is a product decision that should be reviewable in a diff.
///
/// An account with no row here is on the default plan, which entitles
/// everything — so this table taking effect never removes something a customer
/// already had. A restriction is assigned, never inflicted by a deploy.
model AccountEntitlement {
  id        String @id @default(cuid())
  accountId String @unique

  planKey String

  /// ACTIVE | TRIAL | PAST_DUE | CANCELLED. Anything but the first two closes
  /// the ceiling to the plan's own features and nothing extra.
  status String @default("ACTIVE")

  /// Feature keys sold on top of the plan, comma-separated.
  extraFeatures String @default("")

  /// Feature keys CLOR has turned off for this account although its plan or
  /// app tier includes them, comma-separated. Wins over the plan and extras.
  removedFeatures String @default("")

  /// Null falls back to the plan's own limit.
  maxCompanies Int?
  maxUsers     Int?

  /// When a trial or term ends. Null is open-ended.
  validUntil DateTime?

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model FeatureSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  key     String
  enabled Boolean

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, key])
  @@index([accountId, orgId])
}

// ----------------------------
// Sessions and auth hardening
// ----------------------------
// A refresh token is stored only as a hash: a leaked database row must not be
// usable as a credential.
model Session {
  id        String @id @default(cuid())
  accountId String
  userId    String

  refreshTokenHash String  @unique
  userAgent        String?
  ip               String?

  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  // Set when this session is rotated, so a replayed old token is detectable.
  replacedBySessionId String?

  /// An Explore session (the read-only sample company, routes/explore.ts): the pass it came from. Carried through every rotation.
  explorePassId String?

  @@index([accountId, userId, revokedAt])
  @@index([explorePassId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  accountId String
  userId    String

  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

/// Security-relevant authentication events, kept separately from the business
/// audit log so a retention policy can differ.
model AuthEvent {
  id        String  @id @default(cuid())
  accountId String?
  userId    String?

  email     String?
  eventType String // LOGIN_SUCCESS | LOGIN_FAILED | LOCKED_OUT | LOGOUT |
  // PASSWORD_RESET_REQUESTED | PASSWORD_RESET | TOKEN_REFRESHED | SESSION_REVOKED | REFRESH_REFUSED
  ip        String?
  userAgent String?
  detail    String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, eventType, createdAt])
}

// ----------------------------
// Email: settings, outbox, verification
// ----------------------------
model EmailSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String @unique

  // SYSTEM uses the platform's own transport; SMTP uses the org's own server.
  provider String @default("SYSTEM")

  host        String?
  port        Int?
  secure      Boolean @default(true)
  username    String?
  // AES-256-GCM ciphertext. Never returned by the API.
  passwordEnc String?

  fromName  String?
  fromEmail String?
  replyTo   String?

  verifiedAt DateTime?
  lastError  String?

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId])
}

/// Every message the product tries to send, with its outcome. Doubles as the
/// retry queue and the "did the customer actually receive it" answer.
model EmailOutbox {
  id        String  @id @default(cuid())
  accountId String?
  orgId     String?

  templateKey     String
  toEmail         String
  toName          String?
  subject         String
  bodyText        String
  bodyHtml        String?
  /// Files sent with the message, as [{ filename, contentType, base64 }] (a report CSV). Kept so a retry sends them too.
  attachmentsJson String?

  status    String    @default("QUEUED") // QUEUED | SENT | FAILED | SUPPRESSED
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?

  relatedType String?
  relatedId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, orgId, status])
  @@index([templateKey, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String @id @default(cuid())
  accountId String
  userId    String

  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

/// Which notifications an organisation wants, per event.
model NotificationSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  eventKey        String
  enabled         Boolean @default(true)
  /// Extra addresses that receive this event, beyond its natural recipient.
  extraRecipients String?

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, eventKey])
  @@index([accountId, orgId])
}

// ----------------------------
// Security policy and sign-in methods
// ----------------------------
model AuthPolicy {
  id        String @id @default(cuid())
  accountId String
  orgId     String @unique

  maxFailedLogins    Int @default(8)
  lockoutMinutes     Int @default(15)
  sessionDays        Int @default(30)
  accessTokenMinutes Int @default(15)

  passwordMinLength        Int     @default(8)
  passwordRequireMixedCase Boolean @default(false)
  passwordRequireNumber    Boolean @default(false)
  passwordRequireSymbol    Boolean @default(false)

  requireVerifiedEmail  Boolean @default(false)
  /// Comma-separated domains; empty means any address may be invited.
  allowedEmailDomains   String?
  /// Ask for an authenticator code before money-moving payroll actions:
  /// approving a pay run, a bank account change, a settlement, a payment.
  requirePayrollStepUp  Boolean @default(false)
  /// Owners and admins must have an authenticator: until they set one up they
  /// can only reach their own two-factor set-up (SX-09).
  requireAdminTwoFactor Boolean @default(false)
  /// Who may approve their own work — a pay run, salary revision or adjustment
  /// they prepared (A-13): AUTO = only when nobody else could approve it;
  /// STRICT = never; ALLOW = always, every such approval audited. Approving
  /// something about oneself (own salary, bank account, tax) is never allowed.
  makerChecker          String  @default("AUTO")

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId])
}

/// A configured way to sign in. LOCAL always exists implicitly; rows here are
/// the external identity providers an organisation has set up.
model AuthProvider {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  kind    String // OIDC | SAML
  name    String
  enabled Boolean @default(false)

  /// OIDC
  issuer          String?
  clientId        String?
  clientSecretEnc String?
  discoveryUrl    String?
  scopes          String? @default("openid email profile")

  /// SAML
  entryPoint  String?
  entityId    String?
  certificate String?

  /// Restricts which addresses may use this provider.
  emailDomains      String?
  /// TXT value the company publishes on each domain to prove it owns it: clor-domain-verification=<this>.
  domainVerifyToken String?
  /// Domains proven by that record (comma separated). A provider signs in only addresses at these.
  verifiedDomains   String?
  /// Create a user on first successful sign-in instead of refusing.
  autoProvision     Boolean @default(false)
  defaultRoleId     String?
  /// Who chose defaultRoleId: the role is given only while they still hold everything it grants (review N2).
  defaultRoleSetByUserId String?

  lastUsedAt DateTime?
  lastError  String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId, enabled])
}

/// A bearer token an identity provider (Microsoft Entra, Okta, …) uses to
/// provision users into one organisation over SCIM 2.0 (routes/scim.ts). The
/// token is shown once; only its hash is kept.
model ScimToken {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  tokenHash       String    @unique
  tokenPrefix     String
  /// Role given to users the provider creates (none = view nothing until assigned).
  defaultRoleId   String?
  lastUsedAt      DateTime?
  lastError       String?
  /// Revoked tokens are kept (their hash scrambled, so nothing finds them by it); the record and its history stay (A-31).
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@index([accountId, orgId])
}

/// A person's place in an account: the Workspace's account-level authority
/// (docs/workspace/WORKSPACE_IMPLEMENTATION_CHECKLIST.md, D-2).
///
///   OWNER          runs the account: owners, companies, members, plan
///   ADMIN          administers the account, except its owners
///   BILLING_ADMIN  the plan and billing only
///   MEMBER         belongs to the account; what they may do in a company
///                  comes from that company's roles
///
/// Account authority is about the workspace, not the data: no role here opens
/// a ledger, a payslip or an employee file. That still takes a role in the
/// company (spec rule 2.2.7). A person has one membership per account; only a
/// person whose home account this is has one (an outside accountant reaches a
/// company through OutsideAccess instead).
model AccountMembership {
  id            String    @id @default(cuid())
  accountId     String
  userId        String
  /// OWNER | ADMIN | BILLING_ADMIN | MEMBER
  role          String    @default("MEMBER")
  /// ACTIVE | SUSPENDED
  status        String    @default("ACTIVE")
  addedByUserId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([accountId, userId])
  @@index([userId])
  @@index([accountId, role])
}

/// W-3: an invitation into the account, with the companies, branches and
/// company roles the person will get. Only the SHA-256 of the token is kept;
/// the link is single-use (status moves PENDING → ACCEPTED once, under a
/// conditional update) and expires. Seats are not reserved while pending: the
/// plan's user limit is checked when the invitation is accepted.
model AccountInvitation {
  id               String    @id @default(cuid())
  accountId        String
  email            String
  /// ADMIN | BILLING_ADMIN | MEMBER — never OWNER (owners are made by an owner, with step-up)
  accountRole      String    @default("MEMBER")
  /// JSON: [{ orgId, branchIds: [], roleIds: [] }]
  grants           String
  tokenHash        String    @unique
  /// PENDING | ACCEPTED | REVOKED | EXPIRED
  status           String    @default("PENDING")
  expiresAt        DateTime
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedByUserId  String?
  revokedAt        DateTime?
  sendCount        Int       @default(1)
  lastSentAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([accountId, status])
  @@index([accountId, email])
}

/// W-6.1: one row while an account is changing something its plan counts
/// (companies, users). "Count, then create" in two requests at once let both
/// pass a limit; the unique key makes the second wait for the first. A row
/// older than 30 seconds is a crashed holder's and is taken over.
model AccountQuotaLock {
  accountId String
  /// COMPANIES | USERS
  metric    String
  lockedAt  DateTime @default(now())
  holder    String

  @@id([accountId, metric])
}

/// What was done to the account itself — its owners and members' account
/// roles — where AuditLog (which needs a company and a branch) has no place.
/// Plain words in `message`; no secrets or personal data beyond who and what.
model AccountAuditEvent {
  id          String   @id @default(cuid())
  accountId   String
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  /// OK | DENIED
  result      String   @default("OK")
  message     String?
  metadata    String?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
}

/// GAP-006: how a person from another account reaches a company — the
/// company's consent, with a scope and an end. Without a live one, an outside
/// person's membership opens nothing (middleware/tenantContext.ts). Expired is
/// worked out from expiresAt, never stored.
model OutsideAccess {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  userId        String
  homeAccountId String
  /// ACTIVE | SUSPENDED | REVOKED
  status        String    @default("ACTIVE")
  /// Comma separated app keys this person may use here; null = whatever the company has.
  apps          String?
  expiresAt     DateTime?
  /// Who in the company granted it; null = carried over from before engagements existed.
  approvedByUserId String?
  approvedAt       DateTime  @default(now())
  endedByUserId    String?
  endedAt          DateTime?
  reason           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
  @@index([accountId, orgId])
}

/// Every credential CLOR has issued to a machine or a link (GAP-004, Batch 5):
/// SCIM tokens, API keys, site agents, reader push tokens, pay links and
/// invoice share links. The tables that issued them keep their own hash and
/// switches; this row adds what they lacked — one status, an expiry, who made
/// it, when it was last used — and every token check reads both
/// (services/credentials.ts). Only the SHA-256 hash of a token is kept.
model Credential {
  id                String    @id @default(cuid())
  accountId         String
  orgId             String
  /// SCIM | API_KEY | AGENT | DEVICE_PUSH | PAY_LINK | SHARE_LINK
  kind              String
  /// The row that issued it: ScimToken, ApiClient, SiteAgent, AttendanceDevice, PaymentRequest or DocumentShareLink.
  ownerId           String
  /// An agent's directory-sync token names its agent (SiteAgent id); it works only while the agent does.
  parentOwnerId     String?
  tokenHash         String
  /// The first characters, to recognise a token in lists.
  tokenPrefix       String
  label             String?
  /// ACTIVE | SUSPENDED | REVOKED. Expired is worked out from expiresAt, never stored.
  status            String    @default("ACTIVE")
  expiresAt         DateTime?
  /// The credential this one replaced; one successor each.
  rotatedFromId     String?   @unique
  suspendedAt       DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  /// Set when the person who made it left the company or was switched off; cleared by "Mark reviewed".
  needsReviewReason String?
  createdByUserId   String?
  lastUsedAt        DateTime?
  lastUsedIp        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([kind, tokenHash])
  @@index([orgId, kind, status])
  @@index([kind, ownerId])
}

/// What happened to a credential, and who did it. Written, never changed
/// (services/credentials.ts has no update or delete); the closure purge is the
/// only thing that removes rows. Never holds a token, a hash or a share URL.
model CredentialEvent {
  id               String   @id @default(cuid())
  accountId        String
  orgId            String
  /// No foreign key: portal sessions (people database) record here too.
  credentialId     String
  credentialKind   String
  credentialPrefix String?
  /// issued, migrated, rotated, suspended, resumed, extended, revoked, expiry_warning_sent, flagged, reviewed
  eventType        String
  /// USER | SYSTEM | SCIM | AGENT | EMPLOYEE
  actorType        String
  actorId          String?
  /// Name and e-mail at the time, so the history survives the person.
  actorLabel       String?
  ip               String?
  userAgent        String?
  reason           String?
  /// JSON: what changed (expiry before/after, successor id, …).
  metadata         String?
  createdAt        DateTime @default(now())

  @@index([orgId, credentialId, createdAt])
  @@index([orgId, createdAt])
}

/// Something a person should know, shown in the bell every app shares:
/// an approval waiting, a reader gone quiet, a bank change to review, a
/// person provisioned by the directory. One row per person; read state is
/// theirs alone. `link` says where to go: { app, screen, params }.
model Notification {
  id        String    @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  /// approval.requested | reader.alert | connector.alert | payroll.bank_change | scim.user | people.data_request | people.document_expiring | …
  kind      String
  title     String
  body      String?
  linkJson  String?
  /// One notice about one thing, per person: a retry or a second run never sends it twice (services/notifications.ts sendNotice). Null on rows that need no such guard.
  dedupeKey String?
  /// What the notice is about, for retiring it when that thing closes (services/notifications.ts retireNotices):
  /// approval:<requestId> | attendance:<requestId> | leave:<requestId>. Null on notices about nothing that can be withdrawn.
  subjectKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([orgId, userId, dedupeKey])
  @@index([userId, orgId, readAt])
  @@index([orgId, createdAt])
  @@index([orgId, subjectKey])
}

/// Kinds of notification a person does not want in their bell, per company.
model NotificationMute {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, orgId, kind])
}

/// SAML assertions already used to sign in, until they would have expired
/// anyway: a captured assertion cannot be posted a second time.
model SsoAssertionSeen {
  id        String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// ============================================================================
// Billing / subscriptions — the commercial layer (gateway-agnostic)
// ============================================================================
// A tenant's subscription and which apps it bought. Deliberately provider-neutral:
// the gateway* fields are null until a payment provider is chosen, and a
// subscription is honoured on its own fields whether billed or granted by hand.
// `accountId` is kept as a plain scalar (no FK) to leave the Account model
// untouched; it is in this same database, so this is a convention choice, not a
// cross-database necessity.

model Subscription {
  id        String @id @default(cuid())
  accountId String @unique

  /// trialing | active | past_due | paused | cancelled
  status String @default("trialing")

  /// month | year | null (perpetual / manual)
  billingInterval String?

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  /// Money side, left open until a pricing model is decided. INR minor units.
  currency String @default("INR")

  /// The deal CLOR staff set (routes/opsDeals.ts): which plan, how many
  /// units, and what one period costs before GST after any offer. All null on
  /// a subscription set without a price (free, or older ones).
  /// book | custom
  planSource   String?
  /// The price book plan's code, or the custom plan's id.
  planRef      String?
  planName     String?
  /// COMPANY | USER | EMPLOYEE, and how many.
  planUnit     String?
  quantity     Int?
  /// Paise per period, list price (before the offer) and what is charged.
  listAmount   Int?
  periodAmount Int?
  offerId      String?
  offerCode    String?
  /// The offer's price applies until this date; the list price after.
  offerEndsAt  DateTime?

  /// Which gateway backs this, if any. null = unbilled / manual.
  gatewayName           String?
  gatewayCustomerId     String?
  gatewaySubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SubscriptionItem[]

  @@index([status])
}

model SubscriptionItem {
  id             String @id @default(cuid())
  subscriptionId String

  /// accounting | payroll | attendance | people | projects
  appCode String

  /// Tier within the app (e.g. an accounting PLAN_CATALOG key). null = default.
  tier String?

  /// Seats bought for this app. null = not seat-metered.
  seats Int?

  /// Pricing left open: what a unit costs and how it is metered.
  unitAmount Int?
  priceModel String? /// free | per_seat | per_app | flat | null (undecided)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, appCode])
  @@index([appCode])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  gateway    String
  eventId    String
  type       String
  accountId  String?
  payload    String
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())

  /// What became of it: APPLIED (changed a subscription), RECORDED (kept,
  /// nothing to change), FAILED (could not be applied; Retry), REJECTED (the
  /// signature did not match).
  status           String    @default("RECORDED")
  /// The plain sentence the Payments log shows with it: why it failed or was rejected, or what it changed.
  detail           String?
  /// Amount in paise, when the event carries one.
  amount           Int?
  /// The payment's own reference: a gateway payment id, or a UTR for a manual payment.
  reference        String?
  /// The provider-neutral event, kept so a failed one can be applied again.
  normalized       Json?
  attempts         Int       @default(0)
  processedAt      DateTime?
  recordedByUserId String?

  @@unique([gateway, eventId])
  @@index([accountId])
  @@index([receivedAt])
  @@index([status])
}

/// A way customers pay CLOR: cashfree, razorpay or manual (UPI and bank
/// transfer). Set up only in the operator console, Payments. At most one is
/// active (a partial unique index). Test and Live keys are kept apart.
/// Secrets are AES-256-GCM encrypted (services/mailer.ts encryptSecret) as
/// one JSON blob and never leave the server; the console sees only their
/// last four characters, in secretHints.
model PaymentProvider {
  code            String    @id
  enabled         Boolean   @default(false)
  active          Boolean   @default(false)
  /// TEST | LIVE
  mode            String    @default("TEST")
  /// Not secret: { test: { appId }, live: { appId } }, or the manual details (UPI ID, QR, bank).
  config          Json      @default("{}")
  secretsEnc      String?
  secretHints     Json      @default("{}")
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  lastTestMode    String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Which API instance runs a background job right now. The API runs on more
/// than one instance and every instance starts the same timers; the one that
/// takes a job's lease runs that tick and the others skip until it expires.
model JobLease {
  name         String    @id
  holder       String
  until        DateTime
  /// Fencing token: +1 on every take. A run whose token is no longer the row's has lost the lease and must stop.
  token        Int       @default(0)
  /// Set while a run is in progress, cleared when it ends. Null = the period is claimed but nothing is running.
  runningSince DateTime?
  /// Renewed by the running instance; a run whose heartbeat has gone stale was cut off and may be taken over.
  heartbeatAt  DateTime?
}

/// One run of a background job, by whichever instance took its lease (A-48).
/// A worker whose last run is old, or whose runs keep failing, is a scheduler
/// that has stopped: this is where that shows. Kept 30 days.
model JobRun {
  id         String    @id @default(cuid())
  worker     String
  holder     String
  token      Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | OK | FAILED | STOPPED (lease lost or the instance stopping)
  outcome    String    @default("RUNNING")
  /// What the run did, as JSON (rows deleted, invoices raised, …).
  counts     String?
  error      String?

  @@index([worker, startedAt])
}

/// Rate-limit counts shared by every API instance (sign-in, sign-up, password
/// reset, one-time codes, portal and single sign-on). One row per bucket key.
model RateLimitHit {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

/// A write that must not happen twice: a double-clicked receipt, a retried
/// invoice. The first response is kept and handed back to the repeat.
model IdempotentRequest {
  id        String   @id @default(cuid())
  /// Whose request (a hash of the session token) — never shared between people.
  scope     String
  /// "k:<Idempotency-Key>" when the client sent one, else "auto:<path>:<body hash>".
  key       String
  method    String
  path      String
  bodyHash  String
  /// 0 while the first request is still being handled.
  status    Int      @default(0)
  body      String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([scope, key])
  @@index([expiresAt])
}

/// LX-07: a company's closure. The owner asks (after taking a full export),
/// the company stays usable for the notice period (COMPANY_CLOSURE_NOTICE_DAYS,
/// default 30) and can be cancelled; then the scheduled purge deletes every
/// row the company has in every database and marks this DELETED. This row is
/// kept as the record that, when and at whose request it happened (no
/// relation to Org, which is gone by then). See docs/compliance/DATA_DELETION_AND_CLOSURE.md.
model OrgClosure {
  id                String    @id @default(cuid())
  accountId         String
  orgId             String    @unique
  orgName           String
  /// The company's display code, kept after deletion so it is never issued again.
  orgCode           String?
  /// SCHEDULED | CANCELLED | DELETED
  status            String
  reason            String?
  requestedByUserId String
  requestedAt       DateTime
  deleteAfter       DateTime
  cancelledByUserId String?
  cancelledAt       DateTime?
  deletedAt         DateTime?
  /// Rows deleted per table, as JSON, once DELETED.
  deletedCounts     String?
  /// The purge's checkpoint, as JSON { done: [store, …], counts }: a purge that was cut off resumes after the last store it finished.
  purgeProgress     String?
  /// How many purge runs have started for this company, and why the last one stopped, if it did.
  purgeAttempts     Int       @default(0)
  purgeError        String?
  lastPurgeAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, deleteAfter])
}

/// Clor's own staff (W-8.2). Not a customer role: nothing in an account can grant it.
/// CLOR_OPERATOR_USER_IDS names the bootstrap super admins; everyone else is a row here.
model PlatformOperator {
  userId          String   @id
  /// SUPER_ADMIN (Owner) | SALES | SUPPORT | BILLING (Finance) | READ_ONLY
  role            String
  active          Boolean  @default(true)
  note            String?
  createdAt       DateTime @default(now())
  createdByUserId String?
  updatedAt       DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Everything an operator did, append-only (trigger operator_audit_append_only).
model OperatorAuditEvent {
  id              String   @id @default(cuid())
  operatorUserId  String
  action          String
  targetAccountId String?
  targetUserId    String?
  detail          Json?
  ip              String?
  userAgent       String?
  at              DateTime @default(now())

  @@index([at])
  @@index([targetAccountId, at])
  @@index([operatorUserId, at])
  @@index([action, at])
}

/// A "Request a demo" from clor.in. Platform data, not a customer's: there is
/// no account yet, so no accountId and no row-level policy. Written only by the
/// public form; read and changed only by CLOR operators (routes/demoRequests.ts,
/// behind requireOperator).
model DemoRequest {
  id                    String    @id @default(cuid())
  name                  String
  company               String
  /// Lower-cased.
  email                 String
  phone                 String
  city                  String
  /// Employees: 1-10 | 11-20 | 21-50 | 51-200 | 200+
  companySize           String
  /// How many people will sign in.
  users                 Int
  /// App codes (accounting, payroll, people, attendance), in the order ticked.
  apps                  String[]
  message               String?
  /// NEW | CONTACTED | DEMO_DONE | ACCOUNT_CREATED | NOT_A_FIT
  status                String    @default("NEW")
  /// The operator's latest note; every change is also in OperatorAuditEvent.
  note                  String?
  statusChangedAt       DateTime?
  statusChangedByUserId String?
  /// Set while Create account runs, so a second click cannot start a second one.
  provisioningAt        DateTime?
  /// The account made from this request (one at most).
  accountId             String?   @unique
  ownerUserId           String?
  ip                    String?
  userAgent             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email, createdAt])
}

/// A free trial started from clor.in's pricing page (roadmap item 7): the
/// visitor gives an email, a link checks it, and the link's page asks for the
/// company and the apps before the account is made. Only the link token's
/// SHA-256 is kept. Platform data with no account of its own, like
/// DemoRequest, until confirm makes one (accountId). Written by the public
/// routes in routes/signup.ts; read by CLOR operators (Trials in the console).
model TrialSignup {
  id             String    @id @default(cuid())
  /// Lower-cased; where the link was sent.
  email          String
  /// SHA-256 of the link's token; asking again replaces it.
  tokenHash      String    @unique
  /// The app the pricing page's button named (accounting, people, attendance, payroll), for the setup step to tick first.
  app            String?
  /// The published plan the button named (?plan=), when pricing says one.
  planCode       String?
  /// PENDING | CONFIRMED | EXPIRED (set when a later request finds it ran out)
  status         String    @default("PENDING")
  expiresAt      DateTime
  sendCount      Int       @default(0)
  lastSentAt     DateTime?
  /// Set while confirm runs, so a double click cannot make two accounts.
  provisioningAt DateTime?
  confirmedAt    DateTime?
  /// What the setup step said, kept for the console.
  companyName    String?
  apps           String[]  @default([])
  state          String?
  trialDays      Int?
  /// The account made from this signup (one at most).
  accountId      String?   @unique
  ownerUserId    String?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email, createdAt])
  @@index([status, createdAt])
}

/// One version of CLOR's own price list (roadmap item 9). Everything in it is
/// data an operator makes in the operator console; nothing about prices is in
/// the code. Prices change by making a new version, never by editing one that
/// was published: a draft is made (empty, or copied from another book), edited
/// and published, and the book it replaces is archived and kept. At most one is
/// PUBLISHED (partial unique index PriceBook_one_published, migration
/// 20261123090100_price_book_one_published); with none, clor.in shows Request
/// a demo instead of prices. Platform data, not a customer's: no accountId and
/// no row-level policy. Written only by CLOR operators (routes/pricing.ts).
model PriceBook {
  id                String    @id @default(cuid())
  /// 1, 2, 3... in the order the books were made.
  version           Int       @unique
  /// DRAFT | PUBLISHED | ARCHIVED
  status            String    @default("DRAFT")
  currency          String    @default("INR")
  /// What this version is, in a line ("Sample prices — not final").
  note              String?
  /// The book this one was copied from (a copy, or a roll back).
  copiedFromId      String?
  createdByUserId   String?
  publishedAt       DateTime?
  publishedByUserId String?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plans PricePlan[]

  @@index([status])
}

/// A plan in a price book: a name, the apps it carries, how it is counted and
/// what it costs in each billing period it is offered for.
model PricePlan {
  id                String   @id @default(cuid())
  priceBookId       String
  /// Small letters, unique in the book: the ?plan= in a trial link.
  code              String
  name              String
  description       String?
  /// App codes from constants/appCatalog.ts. A plan with an app that is not
  /// available yet stays off clor.in until it is.
  apps              String[]
  /// COMPANY | USER | EMPLOYEE: what one unit is.
  unit              String
  /// Units the base price covers.
  includedUnits     Int      @default(1)
  trialDays         Int      @default(0)
  /// MONTHLY and/or YEARLY.
  periods           String[]
  /// Set: the yearly price is twelve months of the monthly one less this
  /// percent, worked out by the engine. Unset: the yearly price is its own row.
  yearlyDiscountPct Int?
  displayOrder      Int      @default(0)
  showOnWebsite     Boolean  @default(true)
  /// Drawn a little stronger on clor.in. A plain flag, no ribbon.
  highlight         Boolean  @default(false)
  /// Whether GST is added once CLOR charges GST (PlatformSetting billing.gst).
  gstApplies        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  priceBook PriceBook   @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  prices    PlanPrice[]

  @@unique([priceBookId, code])
}

/// What a plan costs for one billing period. Paise, integers. Subscriptions
/// already running are not priced from here: SubscriptionItem keeps its own
/// unitAmount.
model PlanPrice {
  id             String   @id @default(cuid())
  planId         String
  /// MONTHLY | YEARLY
  period         String
  /// Paise for the period, covering the plan's included units.
  basePrice      Int
  /// Paise for each unit beyond the included ones, for the period.
  extraUnitPrice Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan PricePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, period])
}

/// CLOR's own settings as a seller, one row per key, set in the operator
/// console. `billing.gst` (Settings, Tax) holds { registered, gstin, legalName,
/// stateCode, sac, ratePercent }: until CLOR is registered no quote carries
/// GST (services/pricing/settings.ts).
model PlatformSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

/// An Explore pass (roadmap item 6): a link, mailed after a demo request, that
/// opens the shared sample company read-only for 14 days. Only the token's hash
/// is kept. Platform data with no account of its own, like DemoRequest.
model ExplorePass {
  id              String    @id @default(cuid())
  demoRequestId   String?
  /// Lower-cased; where the link was sent.
  email           String
  /// SHA-256 of the link's token; a new token (Resend) replaces it.
  tokenHash       String    @unique
  /// The app the visitor asked for first, for the link to open.
  app             String?
  expiresAt       DateTime
  sentAt          DateTime?
  sendCount       Int       @default(0)
  lastUsedAt      DateTime?
  useCount        Int       @default(0)
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([demoRequestId])
  @@index([email])
}

/// A CLOR operator invited by email (operator console, Team). Becomes a
/// PlatformOperator row the first time somebody signs in with this address,
/// confirmed, and opens the console. Lower-cased email; one live invite each.
model OperatorInvite {
  id              String    @id @default(cuid())
  email           String    @unique
  /// SUPER_ADMIN | SALES | SUPPORT | BILLING | READ_ONLY
  role            String
  note            String?
  invitedByUserId String
  claimedByUserId String?
  claimedAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// The addresses CLOR's own mail goes out from (operator console, Email):
/// sales, support, billing, no-reply. Used when a message goes through the
/// platform's mail server, never a customer's own SMTP.
model EmailSender {
  purpose         String   @id
  name            String
  email           String
  replyTo         String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

/// CLOR's own wording for a template in constants/emailTemplates.ts; with no
/// row the built-in wording is used (Reset to default deletes the row).
model EmailTemplateOverride {
  key             String   @id
  subject         String
  body            String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

/// Each app as clor.in and the app switcher list it: AVAILABLE, COMING_SOON
/// or HIDDEN, and its one-line blurb. With no row the built-in entry is used
/// (constants/appCatalogue.ts). Read publicly at /api/public/app-catalogue.
model AppCatalogueEntry {
  code            String   @id
  status          String
  blurb           String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

/// An invoice CLOR raises to a customer account (roadmap item 8). Made as a
/// DRAFT in the operator console (Money, Invoices), then ISSUED with the next
/// number of the financial year's series, then PAID (Mark paid, or a gateway
/// payment) or VOID. Once issued, what it says is frozen: the seller, buyer,
/// lines, tax and the way to pay are copied in, so a later change to CLOR's
/// UPI ID or a customer's address never rewrites an invoice already sent.
/// Money in paise. `books*` is the CLOR Books connector (item 10): the draft
/// raised in CLOR's own Books company, and what became of it.
model BillingInvoice {
  id               String    @id @default(cuid())
  /// CLOR/26-27/0001; null while a draft, so a discarded draft leaves no gap in the series.
  number           String?   @unique
  accountId        String
  /// DRAFT | ISSUED | PAID | VOID
  status           String    @default("DRAFT")
  issueDate        DateTime?
  dueDate          DateTime?
  /// The months it bills, as YYYY-MM-DD dates.
  periodStart      String?
  periodEnd        String?
  /// [{ description, appCode?, quantity, unitAmount, amount }]
  lines            Json      @default("[]")
  subtotal         Int       @default(0)
  /// gstOn()'s answer: { charged, kind, ratePercent, cgst, sgst, igst, amount, note }
  tax              Json      @default("{}")
  taxTotal         Int       @default(0)
  total            Int       @default(0)
  /// { name, gstin, stateCode, address, email }
  buyer            Json      @default("{}")
  /// CLOR as seller when issued: { legalName, gstin, stateCode, sac, address }
  seller           Json?
  /// The way to pay when issued: UPI ID, QR, bank account (billing/gateway.ts manualPayTo).
  payTo            Json?
  note             String?
  /// How many months a payment of this invoice pays for.
  months           Int       @default(1)
  paidAt           DateTime?
  paidAmount       Int?
  paymentReference String?
  paymentEventId   String?
  voidedAt         DateTime?
  voidReason       String?
  /// NOT_SENT | SENT | FAILED (the CLOR Books connector)
  booksStatus      String    @default("NOT_SENT")
  booksInvoiceId   String?
  booksError       String?
  booksAttempts    Int       @default(0)
  booksSentAt      DateTime?
  /// Card, UPI or netbanking through the active gateway (billing/payLinks.ts):
  /// the provider's payment link for this invoice, made when the customer
  /// first presses Pay online, and reused while the amount is the same.
  payLinkGateway   String?
  payLinkId        String?
  payLinkUrl       String?
  payLinkAmount    Int?
  payLinkAt        DateTime?
  /// MANUAL (drafted by CLOR staff) | RENEWAL (drafted and issued by the renewal job).
  source           String    @default("MANUAL")
  /// For a renewal, the first day of the period it bills (YYYY-MM-DD): one renewal per account and period.
  renewalFor       String?
  createdByUserId  String?
  issuedByUserId   String?
  paidByUserId     String?
  voidedByUserId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([accountId, renewalFor])
  @@index([accountId])
  @@index([status, createdAt])
  @@index([payLinkId])
}

/// A customer's question or problem for CLOR support (Ops plan P1, customer
/// tickets). Opened from the Workspace by anyone signed in to the account;
/// answered by CLOR staff on ops.clor.in. Platform data with no tenant policy,
/// like Subscription: the routes scope every read to the account or to staff.
model SupportTicket {
  id                 String           @id @default(cuid())
  /// Shown as T-1001 and up; one sequence for all customers.
  number             Int              @unique @default(autoincrement())
  accountId          String
  orgId              String?
  openedByUserId     String
  subject            String
  /// QUESTION | PROBLEM | BILLING | DATA | OTHER
  category           String           @default("QUESTION")
  /// accounting | people | attendance | payroll | workspace, when it is about one app.
  app                String?
  /// NORMAL | HIGH | URGENT. The customer may say urgent; staff decide.
  priority           String           @default("NORMAL")
  /// OPEN (with CLOR) | WAITING (with the customer) | SOLVED | CLOSED
  status             String           @default("OPEN")
  /// The error code the customer saw, if they had one.
  requestId          String?
  assignedOperatorId String?
  lastCustomerAt     DateTime?
  lastStaffAt        DateTime?
  solvedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  messages           SupportMessage[]

  @@index([accountId, status])
  @@index([status, updatedAt])
  @@index([openedByUserId])
}

/// One message on a ticket. An internal note is staff only and never shown to the customer.
model SupportMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String
  fromStaff    Boolean       @default(false)
  internal     Boolean       @default(false)
  body         String
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
}

/// Something CLOR staff should know without looking (Ops plan P1, alerts): a
/// job failing, mail stuck, a customer's readers offline, an overdue CLOR
/// invoice, a ticket left waiting. Raised and closed by the alerts job as the
/// condition appears and clears; one open row per key.
model OpsAlert {
  id             String    @id @default(cuid())
  /// What the condition is, e.g. "worker:mail.outbox" or "invoice:<id>". One open alert per key.
  key            String
  /// worker | email | webhook | readers | closure | invoice | ticket | trial | errors
  kind           String
  /// critical | warning
  severity       String
  /// Which staff it is for: SUPPORT | BILLING | SALES (owners see all).
  audience       String
  title          String
  detail         String?
  accountId      String?
  /// Where the console opens it: { page, id?, params? }
  link           Json?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?

  @@index([resolvedAt, severity])
  @@index([key, resolvedAt])
}

/// A notice from CLOR shown at the top of the app (Ops plan P1): news, planned maintenance or a problem being fixed.
/// Written on ops.clor.in; a draft until published; shown from startsAt until endsAt or until ended by hand.
model Announcement {
  id              String    @id @default(cuid())
  title           String
  body            String
  /// info | maintenance | incident. An incident cannot be dismissed while it lasts.
  kind            String    @default("info")
  /// App codes it is about; empty means every customer.
  apps            String[]  @default([])
  /// everyone | admins (account owners, administrators and billing administrators)
  audience        String    @default("everyone")
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  publishedAt     DateTime?
  endedAt         DateTime?
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dismissals AnnouncementDismissal[]

  @@index([publishedAt, endedAt, startsAt])
}

/// One person closed one announcement; it stays closed for them on every device.
model AnnouncementDismissal {
  announcementId String
  userId         String
  at             DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

/// An offer CLOR staff make (operator console, Money › Offers): a code that
/// takes a percent or a fixed amount off a plan's price, for some or all
/// plans and periods, for a number of billing periods or for good, between
/// two dates and up to a number of customers. Applied by staff when they set
/// a customer's subscription (routes/opsDeals.ts). Platform data, no account.
model Offer {
  id              String    @id @default(cuid())
  /// Capitals and digits, unique: what a customer or salesperson quotes.
  code            String    @unique
  name            String
  description     String?
  /// PERCENT | AMOUNT
  kind            String
  /// Percent (1-100) or paise off each period.
  value           Int
  /// Price book plan codes it applies to; empty = every plan, custom ones too.
  planCodes       String[]
  /// MONTHLY / YEARLY; empty = both.
  periods         String[]
  /// Billing periods the price lasts; null = for as long as they subscribe.
  durationPeriods Int?
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  /// How many customers may take it; null = no limit.
  maxRedemptions  Int?
  redemptions     Int       @default(0)
  pausedAt        DateTime?
  archivedAt      DateTime?
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([archivedAt])
}

/// A plan made for a deal, never shown on clor.in (operator console, Money ›
/// Custom plans): its own apps, unit and prices. Tied to one customer, or
/// left open for staff to use with anyone. A subscription copies its price
/// when set, so changing the plan later changes no running subscription.
model CustomPlan {
  id              String    @id @default(cuid())
  /// The customer it was made for; null = any customer.
  accountId       String?
  name            String
  description     String?
  apps            String[]
  /// COMPANY | USER | EMPLOYEE
  unit            String
  includedUnits   Int       @default(1)
  /// Paise per period; null = not offered for that period.
  monthlyPrice    Int?
  monthlyExtra    Int       @default(0)
  yearlyPrice     Int?
  yearlyExtra     Int       @default(0)
  gstApplies      Boolean   @default(true)
  archivedAt      DateTime?
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId])
}

/// A change one CLOR operator asked for that a second one must approve
/// (Ops plan: approval-managed). Today: a subscription deal whose discount is
/// above the limit in the platform setting `ops.approvals`. The request keeps
/// what was asked; approving prices it again and applies it as the approver,
/// with both people on the record. Never approved by the person who asked.
model OpsApproval {
  id              String    @id @default(cuid())
  /// DEAL
  kind            String
  accountId       String?
  /// What was asked, as the route takes it.
  payload         Json
  /// One line for the list: "Growth, 25 employees, yearly, 40% off (FEST40)".
  summary         String
  /// The share of the list price taken off, in whole percent.
  discountPercent Int?
  reason          String
  requestedBy     String
  /// PENDING | APPROVED | REJECTED | CANCELLED | EXPIRED
  status          String    @default("PENDING")
  decidedBy       String?
  decidedAt       DateTime?
  decisionNote    String?
  expiresAt       DateTime
  /// What applying it gave: { invoiceId }, or the reason it could not be applied.
  result          Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([accountId])
}

// ----------------------------
// Each time the API fails a request (a 500). For CLOR staff: the alerts job counts them, and a request id finds one.
// Never the error's message: it can carry a customer's data. Pruned after 14 days.
// ----------------------------
model ApiError {
  id        String   @id @default(cuid())
  /// The id the customer was shown on the error, to quote to support.
  requestId String?
  method    String
  /// The route as mounted, ids replaced by ":id", no query string.
  route     String
  /// The error's class name, e.g. "TypeError" or "PrismaClientKnownRequestError".
  errorName String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([requestId])
}
