// ============================================================================
// Clor Platform — its own database
// ============================================================================
//
// Who can sign in, which company they belong to, and what they are allowed to
// do. Accounts, orgs, branches, users, sessions, roles, permissions, the audit
// trail, entitlements and the auth/email plumbing all live here — the control
// plane every accounting query assumes but none of them owns.
//
// Why a boundary rather than forty more tables next to Invoice. The platform is
// the part that is shared by everything and changes on its own rhythm: a user
// is invited once and reads a ledger for years, a session is minted and revoked
// far more often than a journal is posted, and an auth policy is a security
// concern with its own retention. Keeping it in its own database means it can
// be backed up, migrated and reasoned about without touching an accounting
// query, and an accidental join from a sales report into a password hash cannot
// be written because the two are not in the same database.
//
// How it stays connected. Accounting holds the platform's identifiers —
// `accountId`, `orgId`, `branchId`, `userId`, `warehouseId` — as plain strings,
// with no cross-database foreign keys, because there is no such thing.
// Referential integrity across the boundary is the application's job and is
// enforced where the two meet.
//
// The one honest cost. A write cannot span both databases in a single
// transaction, so anything that touches platform and accounting together is two
// steps, each idempotent, in an order a crash in between can recover from.

generator platformClient {
  provider = "prisma-client-js"
  output   = "../../src/generated/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

// ----------------------------
// Core tenancy
// ----------------------------
model Account {
  id                   String    @id @default(cuid())
  name                 String
  /// Client ID shown to people: the code of the account's first company (4831920657). Never changed (services/displayCodes.ts).
  code                 String?   @unique
  /// The code it had under the first scheme (KAVE-C100), still found so old links work.
  legacyCode           String?   @unique
  /// Set only by the rollout migration for accounts that predate explicit
  /// subscriptions. A missing subscription is open only when this marker is
  /// present; newly created/unrecognised accounts fail closed.
  legacyUnrestrictedAt DateTime?
  /// Set by a Clor operator (W-8.2): every company in the account refuses work until reinstated.
  suspendedAt          DateTime?
  suspendedReason      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orgs  Org[]
  users User[]

  entitlement AccountEntitlement?
}

model Org {
  id         String  @id @default(cuid())
  accountId  String
  name       String
  /// The public handle: the `agc` in agc.books.clor.in. Separate from `id`
  /// on purpose — the id is what foreign keys and authorisation use and never
  /// changes, the slug is what a person reads and may one day need to change.
  /// Nullable so existing rows are valid before the backfill.
  slug       String? @unique
  /// Company code: ten random digits, the last a check digit (4831920657). In the address (/o/<code>/). Never changed.
  code       String? @unique
  /// No longer issued; kept for rows numbered under the first scheme.
  codeNumber Int?
  /// The code it had under the first scheme (KAVE-C100), still found so old links work.
  legacyCode String? @unique
  /// Archived (services/companyArchive.ts): read-only, out of the switcher's main list and the plan's company count, reversible.
  archivedAt       DateTime?
  archivedReason   String?
  archivedNote     String?
  archivedByUserId String?
  legalName  String?
  pan        String?

  /// The currency the books are kept in. Every ledger posting is in this
  /// currency, whatever currency the document was raised in.
  baseCurrency String @default("INR")

  /// The rest of the company master, as JSON.
  ///
  /// Trade name, entity type, industries, the financial year, the contact
  /// details and the registered address. A column each would be a dozen more
  /// nullable columns nothing queries or reports on — these are read as a whole
  /// on one screen and written as a whole from one form. Anything that later
  /// needs filtering or a report earns its own column then.
  profileJson String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("OrgCreatedBy", fields: [createdByUserId], references: [id])

  branches Branch[]
  roles    Role[]
  members  UserOrgMembership[]
  audit    AuditLog[]

  @@unique([accountId, name])
  @@index([accountId])
}

model Branch {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  branchCode   String
  branchName   String
  addressLine1 String
  addressLine2 String?
  city         String?
  state        String
  country      String

  gstin               String?
  // Stored as a string rather than a Postgres enum: adding a value to an enum
  // is a migration, and these lists grow. (REGULAR | COMPOSITION | UNREGISTERED)
  gstRegistrationType String  @default("UNREGISTERED")
  phone               String?
  email               String?
  contactPerson       String?
  /// Branch status (developer change 9 Oct 2026): inactive branches stay for history but take no new work.
  isActive            Boolean @default(true)

  parentBranchId          String?
  shareHeadOfficeSettings Boolean @default(false)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Branch?  @relation("BranchParent", fields: [parentBranchId], references: [id])
  children Branch[] @relation("BranchParent")

  createdBy User @relation("BranchCreatedBy", fields: [createdByUserId], references: [id])

  users UserBranchMembership[]

  @@unique([orgId, branchCode])
  @@index([accountId, orgId])
}

// ----------------------------
// Users + access
// ----------------------------
model User {
  id        String @id @default(cuid())
  accountId String

  username     String? // optional username login
  /// User ID: ten random digits, the last a check digit. One per person, the same in every company they join.
  code         String? @unique
  /// No longer issued; kept for rows numbered under the first scheme.
  codeNumber   Int?
  /// The ID they had under the first scheme (KAVE-C100-U01).
  legacyCode   String? @unique
  email        String // primary login
  fullName     String
  passwordHash String
  isActive     Boolean @default(true)
  /// Marked as left (services/leavers.ts): when, why, by whom, last working day. Sign-in is off (isActive false); history keeps their name.
  leftAt         DateTime?
  leftReason     String?
  leftNote       String?
  lastWorkingDay String?
  leftByUserId   String?
  /// Their address before it was released for a successor (email then holds a placeholder).
  releasedEmail  String?

  // Profile. `fullName` stays the single source for display so every existing
  // reader keeps working; first and last are what the user actually edits and
  // fullName is recomposed from them on save.
  firstName String?
  lastName  String?
  phone     String?

  // A square image the user picked, resized client-side and stored as a data
  // URL. Capped well under a megabyte by the route. This avoids standing up
  // object storage for something that is a few kilobytes per user, and it
  // keeps working on an install with no network egress.
  avatarUrl String?

  // Authenticator app (TOTP, RFC 6238). The secret is encrypted at rest;
  // enabled only once a code from it has been checked. The last time step
  // used stops a code being replayed; recovery codes are stored hashed.
  totpSecretEnc    String?
  totpEnabledAt    DateTime?
  totpLastStep     Int?
  totpRecoveryJson String?

  // Lockout state. Cleared on a successful sign-in.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  emailVerifiedAt  DateTime?

  /// Which privacy notice and terms the person was shown at sign-up, and
  /// when they went ahead — so consent can be shown, not just asserted.
  noticeVersion    String?
  noticeAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  orgMemberships    UserOrgMembership[]
  branchMemberships UserBranchMembership[]
  roleAssignments   UserRoleAssignment[]
  warehouseAccess   UserWarehouseAccess[]

  createdOrgs     Org[]    @relation("OrgCreatedBy")
  createdBranches Branch[] @relation("BranchCreatedBy")


  /// Globally unique, not per account. Login resolves a user by email across
  /// every account, so two accounts sharing one would make it non-deterministic
  /// — and a person invited into a second company must be the SAME login, not a
  /// second identity with the same address. The route already refused a
  /// duplicate; this makes it structural rather than a rule one handler happens
  /// to keep.
  @@unique([email])
  @@index([accountId])

  platformOperator PlatformOperator?
}

model UserOrgMembership {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  userId    String

  createdAt DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, userId])
  @@index([accountId, orgId])
}

model UserBranchMembership {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String
  userId    String

  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, userId])
  @@index([accountId, orgId, branchId])
}

model UserWarehouseAccess {
  id          String @id @default(cuid())
  accountId   String
  orgId       String
  branchId    String
  warehouseId String
  userId      String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, warehouseId, userId])
  @@index([accountId, orgId, branchId, warehouseId])
}

// ----------------------------
// Roles + permissions
// ----------------------------
model Role {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  // Optional: branch-scoped custom role
  branchId  String?

  name             String
  description      String?
  // Stored as a string rather than a Postgres enum: adding a value to an enum
  // is a migration, and these lists grow. (ADMIN | ACCOUNTANT | SALES | CUSTOM)
  roleType         String
  // Limits list and single-document reads to rows the holder created
  // (Odoo "Own Documents Only"). One unrestricted role lifts it.
  ownDocumentsOnly Boolean @default(false)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([orgId, branchId, name])
  @@index([accountId, orgId])
}

model Permission {
  id        String  @id @default(cuid())
  module    String
  subModule String?
  // Stored as a string rather than a Postgres enum: adding a value to an enum
  // is a migration, and these lists grow. (VIEW | CREATE | EDIT | DELETE | APPROVE | EXPORT)
  action    String

  rolePermissions RolePermission[]

  @@unique([module, subModule, action])
}

model RolePermission {
  id           String  @id @default(cuid())
  accountId    String
  orgId        String
  roleId       String
  permissionId String
  allowed      Boolean @default(true)
  // Field-level access, as in ERPNext's permlevels. Level 0 covers ordinary
  // fields; a field declared at level 1 needs a rule granting level >= 1.
  permLevel    Int     @default(0)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([accountId, orgId])
}

// Role assignment per org and optionally per branch.
// If branchId is null => org-wide role.
model UserRoleAssignment {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  branchId  String?
  userId    String
  roleId    String

  createdByUserId String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, branchId, userId, roleId])
  @@index([accountId, orgId, branchId])
}

// ----------------------------
// Audit log
// ----------------------------
model AuditLog {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  branchId  String

  entity   String
  entityId String
  action   String
  message  String?
  // SQLite-compatible: store JSON metadata as string (optional)
  metadata String?

  /// A CLOR user id, or `portal:<employeeId>`, `system`, `api:<client>` (no foreign key: see migration 20261028090000).
  createdByUserId String
  createdAt       DateTime @default(now())
  /// The request id (X-Request-Id) that wrote it; People's change log shares it (D-V8).
  correlationId   String?

  org       Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([accountId, orgId, branchId])
  @@index([orgId, entityId])
}

// ----------------------------
// Role profiles — bundles of roles, assigned as one unit
// ----------------------------
model RoleProfile {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  description String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles       RoleProfileRole[]
  assignments UserRoleProfile[]

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

model RoleProfileRole {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  profileId String
  roleId    String

  profile RoleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, roleId])
  @@index([accountId, orgId])
}

model UserRoleProfile {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  profileId String
  branchId  String?

  createdByUserId String
  createdAt       DateTime @default(now())

  profile RoleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([accountId, orgId, userId, profileId])
  @@index([accountId, orgId, userId])
}

// ----------------------------
// User permissions — document-level restrictions, generalised
// ----------------------------
// Branch and warehouse access already have dedicated tables because they are
// also the tenancy boundary. This covers everything else: restrict a user to
// certain customers, vendors, cost centres, and so on.
model UserPermission {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  userId    String

  entityType String // CUSTOMER | VENDOR | COST_CENTRE | ITEM_GROUP
  entityId   String
  label      String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([accountId, orgId, userId, entityType, entityId])
  @@index([accountId, orgId, userId, entityType])
}

// ----------------------------
// Feature toggles, per organisation
// ----------------------------
/// Which plan an account is on, and anything sold to it beyond the plan.
///
/// Only the assignment is data; the plans themselves live in planCatalog.ts,
/// because a plan is a product decision that should be reviewable in a diff.
///
/// An account with no row here is on the default plan, which entitles
/// everything — so this table taking effect never removes something a customer
/// already had. A restriction is assigned, never inflicted by a deploy.
model AccountEntitlement {
  id        String @id @default(cuid())
  accountId String @unique

  planKey String

  /// ACTIVE | TRIAL | PAST_DUE | CANCELLED. Anything but the first two closes
  /// the ceiling to the plan's own features and nothing extra.
  status String @default("ACTIVE")

  /// Feature keys sold on top of the plan, comma-separated.
  extraFeatures String @default("")

  /// Null falls back to the plan's own limit.
  maxCompanies Int?
  maxUsers     Int?

  /// When a trial or term ends. Null is open-ended.
  validUntil DateTime?

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model FeatureSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  key     String
  enabled Boolean

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, key])
  @@index([accountId, orgId])
}

// ----------------------------
// Sessions and auth hardening
// ----------------------------
// A refresh token is stored only as a hash: a leaked database row must not be
// usable as a credential.
model Session {
  id        String @id @default(cuid())
  accountId String
  userId    String

  refreshTokenHash String  @unique
  userAgent        String?
  ip               String?

  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  // Set when this session is rotated, so a replayed old token is detectable.
  replacedBySessionId String?

  @@index([accountId, userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  accountId String
  userId    String

  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

/// Security-relevant authentication events, kept separately from the business
/// audit log so a retention policy can differ.
model AuthEvent {
  id        String  @id @default(cuid())
  accountId String?
  userId    String?

  email     String?
  eventType String // LOGIN_SUCCESS | LOGIN_FAILED | LOCKED_OUT | LOGOUT |
  // PASSWORD_RESET_REQUESTED | PASSWORD_RESET | TOKEN_REFRESHED | SESSION_REVOKED
  ip        String?
  userAgent String?
  detail    String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, eventType, createdAt])
}

// ----------------------------
// Email: settings, outbox, verification
// ----------------------------
model EmailSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String @unique

  // SYSTEM uses the platform's own transport; SMTP uses the org's own server.
  provider String @default("SYSTEM")

  host        String?
  port        Int?
  secure      Boolean @default(true)
  username    String?
  // AES-256-GCM ciphertext. Never returned by the API.
  passwordEnc String?

  fromName  String?
  fromEmail String?
  replyTo   String?

  verifiedAt DateTime?
  lastError  String?

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId])
}

/// Every message the product tries to send, with its outcome. Doubles as the
/// retry queue and the "did the customer actually receive it" answer.
model EmailOutbox {
  id        String  @id @default(cuid())
  accountId String?
  orgId     String?

  templateKey     String
  toEmail         String
  toName          String?
  subject         String
  bodyText        String
  bodyHtml        String?
  /// Files sent with the message, as [{ filename, contentType, base64 }] (a report CSV). Kept so a retry sends them too.
  attachmentsJson String?

  status    String    @default("QUEUED") // QUEUED | SENT | FAILED | SUPPRESSED
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?

  relatedType String?
  relatedId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, orgId, status])
  @@index([templateKey, createdAt])
}

model EmailVerificationToken {
  id        String @id @default(cuid())
  accountId String
  userId    String

  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, usedAt])
}

/// Which notifications an organisation wants, per event.
model NotificationSetting {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  eventKey        String
  enabled         Boolean @default(true)
  /// Extra addresses that receive this event, beyond its natural recipient.
  extraRecipients String?

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, eventKey])
  @@index([accountId, orgId])
}

// ----------------------------
// Security policy and sign-in methods
// ----------------------------
model AuthPolicy {
  id        String @id @default(cuid())
  accountId String
  orgId     String @unique

  maxFailedLogins    Int @default(8)
  lockoutMinutes     Int @default(15)
  sessionDays        Int @default(30)
  accessTokenMinutes Int @default(15)

  passwordMinLength        Int     @default(8)
  passwordRequireMixedCase Boolean @default(false)
  passwordRequireNumber    Boolean @default(false)
  passwordRequireSymbol    Boolean @default(false)

  requireVerifiedEmail  Boolean @default(false)
  /// Comma-separated domains; empty means any address may be invited.
  allowedEmailDomains   String?
  /// Ask for an authenticator code before money-moving payroll actions:
  /// approving a pay run, a bank account change, a settlement, a payment.
  requirePayrollStepUp  Boolean @default(false)
  /// Owners and admins must have an authenticator: until they set one up they
  /// can only reach their own two-factor set-up (SX-09).
  requireAdminTwoFactor Boolean @default(false)
  /// Who may approve their own work — a pay run, salary revision or adjustment
  /// they prepared (A-13): AUTO = only when nobody else could approve it;
  /// STRICT = never; ALLOW = always, every such approval audited. Approving
  /// something about oneself (own salary, bank account, tax) is never allowed.
  makerChecker          String  @default("AUTO")

  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId])
}

/// A configured way to sign in. LOCAL always exists implicitly; rows here are
/// the external identity providers an organisation has set up.
model AuthProvider {
  id        String @id @default(cuid())
  accountId String
  orgId     String

  kind    String // OIDC | SAML
  name    String
  enabled Boolean @default(false)

  /// OIDC
  issuer          String?
  clientId        String?
  clientSecretEnc String?
  discoveryUrl    String?
  scopes          String? @default("openid email profile")

  /// SAML
  entryPoint  String?
  entityId    String?
  certificate String?

  /// Restricts which addresses may use this provider.
  emailDomains      String?
  /// TXT value the company publishes on each domain to prove it owns it: clor-domain-verification=<this>.
  domainVerifyToken String?
  /// Domains proven by that record (comma separated). A provider signs in only addresses at these.
  verifiedDomains   String?
  /// Create a user on first successful sign-in instead of refusing.
  autoProvision     Boolean @default(false)
  defaultRoleId     String?

  lastUsedAt DateTime?
  lastError  String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId, enabled])
}

/// A bearer token an identity provider (Microsoft Entra, Okta, …) uses to
/// provision users into one organisation over SCIM 2.0 (routes/scim.ts). The
/// token is shown once; only its hash is kept.
model ScimToken {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  tokenHash       String    @unique
  tokenPrefix     String
  /// Role given to users the provider creates (none = view nothing until assigned).
  defaultRoleId   String?
  lastUsedAt      DateTime?
  lastError       String?
  /// Revoked tokens are kept (their hash scrambled, so nothing finds them by it); the record and its history stay (A-31).
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@index([accountId, orgId])
}

/// A person's place in an account: the Workspace's account-level authority
/// (docs/workspace/WORKSPACE_IMPLEMENTATION_CHECKLIST.md, D-2).
///
///   OWNER          runs the account: owners, companies, members, plan
///   ADMIN          administers the account, except its owners
///   BILLING_ADMIN  the plan and billing only
///   MEMBER         belongs to the account; what they may do in a company
///                  comes from that company's roles
///
/// Account authority is about the workspace, not the data: no role here opens
/// a ledger, a payslip or an employee file. That still takes a role in the
/// company (spec rule 2.2.7). A person has one membership per account; only a
/// person whose home account this is has one (an outside accountant reaches a
/// company through OutsideAccess instead).
model AccountMembership {
  id            String    @id @default(cuid())
  accountId     String
  userId        String
  /// OWNER | ADMIN | BILLING_ADMIN | MEMBER
  role          String    @default("MEMBER")
  /// ACTIVE | SUSPENDED
  status        String    @default("ACTIVE")
  addedByUserId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([accountId, userId])
  @@index([userId])
  @@index([accountId, role])
}

/// W-3: an invitation into the account, with the companies, branches and
/// company roles the person will get. Only the SHA-256 of the token is kept;
/// the link is single-use (status moves PENDING → ACCEPTED once, under a
/// conditional update) and expires. Seats are not reserved while pending: the
/// plan's user limit is checked when the invitation is accepted.
model AccountInvitation {
  id               String    @id @default(cuid())
  accountId        String
  email            String
  /// ADMIN | BILLING_ADMIN | MEMBER — never OWNER (owners are made by an owner, with step-up)
  accountRole      String    @default("MEMBER")
  /// JSON: [{ orgId, branchIds: [], roleIds: [] }]
  grants           String
  tokenHash        String    @unique
  /// PENDING | ACCEPTED | REVOKED | EXPIRED
  status           String    @default("PENDING")
  expiresAt        DateTime
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedByUserId  String?
  revokedAt        DateTime?
  sendCount        Int       @default(1)
  lastSentAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([accountId, status])
  @@index([accountId, email])
}

/// W-6.1: one row while an account is changing something its plan counts
/// (companies, users). "Count, then create" in two requests at once let both
/// pass a limit; the unique key makes the second wait for the first. A row
/// older than 30 seconds is a crashed holder's and is taken over.
model AccountQuotaLock {
  accountId String
  /// COMPANIES | USERS
  metric    String
  lockedAt  DateTime @default(now())
  holder    String

  @@id([accountId, metric])
}

/// What was done to the account itself — its owners and members' account
/// roles — where AuditLog (which needs a company and a branch) has no place.
/// Plain words in `message`; no secrets or personal data beyond who and what.
model AccountAuditEvent {
  id          String   @id @default(cuid())
  accountId   String
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  /// OK | DENIED
  result      String   @default("OK")
  message     String?
  metadata    String?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
}

/// GAP-006: how a person from another account reaches a company — the
/// company's consent, with a scope and an end. Without a live one, an outside
/// person's membership opens nothing (middleware/tenantContext.ts). Expired is
/// worked out from expiresAt, never stored.
model OutsideAccess {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  userId        String
  homeAccountId String
  /// ACTIVE | SUSPENDED | REVOKED
  status        String    @default("ACTIVE")
  /// Comma separated app keys this person may use here; null = whatever the company has.
  apps          String?
  expiresAt     DateTime?
  /// Who in the company granted it; null = carried over from before engagements existed.
  approvedByUserId String?
  approvedAt       DateTime  @default(now())
  endedByUserId    String?
  endedAt          DateTime?
  reason           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
  @@index([accountId, orgId])
}

/// Every credential CLOR has issued to a machine or a link (GAP-004, Batch 5):
/// SCIM tokens, API keys, site agents, reader push tokens, pay links and
/// invoice share links. The tables that issued them keep their own hash and
/// switches; this row adds what they lacked — one status, an expiry, who made
/// it, when it was last used — and every token check reads both
/// (services/credentials.ts). Only the SHA-256 hash of a token is kept.
model Credential {
  id                String    @id @default(cuid())
  accountId         String
  orgId             String
  /// SCIM | API_KEY | AGENT | DEVICE_PUSH | PAY_LINK | SHARE_LINK
  kind              String
  /// The row that issued it: ScimToken, ApiClient, SiteAgent, AttendanceDevice, PaymentRequest or DocumentShareLink.
  ownerId           String
  /// An agent's directory-sync token names its agent (SiteAgent id); it works only while the agent does.
  parentOwnerId     String?
  tokenHash         String
  /// The first characters, to recognise a token in lists.
  tokenPrefix       String
  label             String?
  /// ACTIVE | SUSPENDED | REVOKED. Expired is worked out from expiresAt, never stored.
  status            String    @default("ACTIVE")
  expiresAt         DateTime?
  /// The credential this one replaced; one successor each.
  rotatedFromId     String?   @unique
  suspendedAt       DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  /// Set when the person who made it left the company or was switched off; cleared by "Mark reviewed".
  needsReviewReason String?
  createdByUserId   String?
  lastUsedAt        DateTime?
  lastUsedIp        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([kind, tokenHash])
  @@index([orgId, kind, status])
  @@index([kind, ownerId])
}

/// What happened to a credential, and who did it. Written, never changed
/// (services/credentials.ts has no update or delete); the closure purge is the
/// only thing that removes rows. Never holds a token, a hash or a share URL.
model CredentialEvent {
  id               String   @id @default(cuid())
  accountId        String
  orgId            String
  /// No foreign key: portal sessions (people database) record here too.
  credentialId     String
  credentialKind   String
  credentialPrefix String?
  /// issued, migrated, rotated, suspended, resumed, extended, revoked, expiry_warning_sent, flagged, reviewed
  eventType        String
  /// USER | SYSTEM | SCIM | AGENT | EMPLOYEE
  actorType        String
  actorId          String?
  /// Name and e-mail at the time, so the history survives the person.
  actorLabel       String?
  ip               String?
  userAgent        String?
  reason           String?
  /// JSON: what changed (expiry before/after, successor id, …).
  metadata         String?
  createdAt        DateTime @default(now())

  @@index([orgId, credentialId, createdAt])
  @@index([orgId, createdAt])
}

/// Something a person should know, shown in the bell every app shares:
/// an approval waiting, a reader gone quiet, a bank change to review, a
/// person provisioned by the directory. One row per person; read state is
/// theirs alone. `link` says where to go: { app, screen, params }.
model Notification {
  id        String    @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  /// approval.requested | reader.alert | connector.alert | payroll.bank_change | scim.user | people.data_request | people.document_expiring | …
  kind      String
  title     String
  body      String?
  linkJson  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, orgId, readAt])
  @@index([orgId, createdAt])
}

/// Kinds of notification a person does not want in their bell, per company.
model NotificationMute {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, orgId, kind])
}

/// SAML assertions already used to sign in, until they would have expired
/// anyway: a captured assertion cannot be posted a second time.
model SsoAssertionSeen {
  id        String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// ============================================================================
// Billing / subscriptions — the commercial layer (gateway-agnostic)
// ============================================================================
// A tenant's subscription and which apps it bought. Deliberately provider-neutral:
// the gateway* fields are null until a payment provider is chosen, and a
// subscription is honoured on its own fields whether billed or granted by hand.
// `accountId` is kept as a plain scalar (no FK) to leave the Account model
// untouched; it is in this same database, so this is a convention choice, not a
// cross-database necessity.

model Subscription {
  id        String @id @default(cuid())
  accountId String @unique

  /// trialing | active | past_due | paused | cancelled
  status String @default("trialing")

  /// month | year | null (perpetual / manual)
  billingInterval String?

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  /// Money side, left open until a pricing model is decided. INR minor units.
  currency String @default("INR")

  /// Which gateway backs this, if any. null = unbilled / manual.
  gatewayName           String?
  gatewayCustomerId     String?
  gatewaySubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SubscriptionItem[]

  @@index([status])
}

model SubscriptionItem {
  id             String @id @default(cuid())
  subscriptionId String

  /// accounting | payroll | attendance | people | projects
  appCode String

  /// Tier within the app (e.g. an accounting PLAN_CATALOG key). null = default.
  tier String?

  /// Seats bought for this app. null = not seat-metered.
  seats Int?

  /// Pricing left open: what a unit costs and how it is metered.
  unitAmount Int?
  priceModel String? /// free | per_seat | per_app | flat | null (undecided)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, appCode])
  @@index([appCode])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  gateway    String
  eventId    String
  type       String
  accountId  String?
  payload    String
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@unique([gateway, eventId])
  @@index([accountId])
}

/// Which API instance runs a background job right now. The API runs on more
/// than one instance and every instance starts the same timers; the one that
/// takes a job's lease runs that tick and the others skip until it expires.
model JobLease {
  name         String    @id
  holder       String
  until        DateTime
  /// Fencing token: +1 on every take. A run whose token is no longer the row's has lost the lease and must stop.
  token        Int       @default(0)
  /// Set while a run is in progress, cleared when it ends. Null = the period is claimed but nothing is running.
  runningSince DateTime?
  /// Renewed by the running instance; a run whose heartbeat has gone stale was cut off and may be taken over.
  heartbeatAt  DateTime?
}

/// One run of a background job, by whichever instance took its lease (A-48).
/// A worker whose last run is old, or whose runs keep failing, is a scheduler
/// that has stopped: this is where that shows. Kept 30 days.
model JobRun {
  id         String    @id @default(cuid())
  worker     String
  holder     String
  token      Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING | OK | FAILED | STOPPED (lease lost or the instance stopping)
  outcome    String    @default("RUNNING")
  /// What the run did, as JSON (rows deleted, invoices raised, …).
  counts     String?
  error      String?

  @@index([worker, startedAt])
}

/// Rate-limit counts shared by every API instance (sign-in, sign-up, password
/// reset, one-time codes, portal and single sign-on). One row per bucket key.
model RateLimitHit {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

/// A write that must not happen twice: a double-clicked receipt, a retried
/// invoice. The first response is kept and handed back to the repeat.
model IdempotentRequest {
  id        String   @id @default(cuid())
  /// Whose request (a hash of the session token) — never shared between people.
  scope     String
  /// "k:<Idempotency-Key>" when the client sent one, else "auto:<path>:<body hash>".
  key       String
  method    String
  path      String
  bodyHash  String
  /// 0 while the first request is still being handled.
  status    Int      @default(0)
  body      String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([scope, key])
  @@index([expiresAt])
}

/// LX-07: a company's closure. The owner asks (after taking a full export),
/// the company stays usable for the notice period (COMPANY_CLOSURE_NOTICE_DAYS,
/// default 30) and can be cancelled; then the scheduled purge deletes every
/// row the company has in every database and marks this DELETED. This row is
/// kept as the record that, when and at whose request it happened (no
/// relation to Org, which is gone by then). See docs/compliance/DATA_DELETION_AND_CLOSURE.md.
model OrgClosure {
  id                String    @id @default(cuid())
  accountId         String
  orgId             String    @unique
  orgName           String
  /// The company's display code, kept after deletion so it is never issued again.
  orgCode           String?
  /// SCHEDULED | CANCELLED | DELETED
  status            String
  reason            String?
  requestedByUserId String
  requestedAt       DateTime
  deleteAfter       DateTime
  cancelledByUserId String?
  cancelledAt       DateTime?
  deletedAt         DateTime?
  /// Rows deleted per table, as JSON, once DELETED.
  deletedCounts     String?
  /// The purge's checkpoint, as JSON { done: [store, …], counts }: a purge that was cut off resumes after the last store it finished.
  purgeProgress     String?
  /// How many purge runs have started for this company, and why the last one stopped, if it did.
  purgeAttempts     Int       @default(0)
  purgeError        String?
  lastPurgeAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, deleteAfter])
}

/// Clor's own staff (W-8.2). Not a customer role: nothing in an account can grant it.
/// CLOR_OPERATOR_USER_IDS names the bootstrap super admins; everyone else is a row here.
model PlatformOperator {
  userId          String   @id
  /// SUPER_ADMIN | SUPPORT | BILLING
  role            String
  active          Boolean  @default(true)
  note            String?
  createdAt       DateTime @default(now())
  createdByUserId String?
  updatedAt       DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Everything an operator did, append-only (trigger operator_audit_append_only).
model OperatorAuditEvent {
  id              String   @id @default(cuid())
  operatorUserId  String
  action          String
  targetAccountId String?
  targetUserId    String?
  detail          Json?
  ip              String?
  userAgent       String?
  at              DateTime @default(now())

  @@index([at])
  @@index([targetAccountId, at])
}
