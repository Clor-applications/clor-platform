// ============================================================================
// Clor People — its own database
// ============================================================================
//
// Who works here. One person record, shared by everything that needs to know
// about a person, and owned by none of them.
//
// Payroll, attendance, timesheets and leave all need the same person, and the
// failure this prevents is each of them growing its own staff list: five
// spellings of one name, five joining dates, and no answer to which is right.
// So the person lives here, and every other module holds `employeeId` across
// the boundary the way it holds an org or a ledger account.
//
// What is deliberately NOT here: anything only one module cares about. A bank
// account and a PAN are payroll's and live in payroll, because a staff
// directory should not be a place to read them. Attendance keeps its own
// records against the same id. The rule is that a field belongs to the module
// that has to be right about it.
//
// Separate from accounting for the same reason payroll is: different
// sensitivity, different retention, and a boundary that cannot be crossed by
// accident because the join cannot be written.

generator peopleClient {
  provider = "prisma-client-js"
  output   = "../../src/generated/people"
}

datasource db {
  provider = "postgresql"
  url      = env("PEOPLE_DATABASE_URL")
}

/// A person the company pays. Small on purpose: the payroll-only fields are
/// next door, and an HR module later adds its own table beside this one.
model Employee {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  /// Null = not tied to one location, the same convention masters use.
  branchId  String?

  /// Human-facing identifier, unique within the org when set.
  code        String?
  name        String
  /// What they like to be called (PRD CORE-02); the legal name stays in name/firstName/lastName.
  preferredName String?
  /// Bumped by every write through the one write path; an edit that names an older version is refused (409 STALE).
  version     Int     @default(1)
  email       String?
  phone       String?
  designation String?
  department  String?

  /// When the current stint began. Attendance and leave proration read this, so a
  /// rejoin moves it; the first stint's start stays in `firstJoiningDate` and
  /// every stint is an EmploymentEpisode (docs/people/02-PRD.md FND-06).
  dateOfJoining String?
  dateOfLeaving String?
  /// The first day they ever joined this company; never moved by a rejoin.
  firstJoiningDate  String?
  /// Which stint they are on (EmploymentEpisode.seq): 1 until a rejoin.
  currentEpisodeSeq Int     @default(1)
  /// The day probation was confirmed (LIFE-03); null while on probation or where there was none.
  confirmedOn       String?
  /// Where they work in law: the establishment (shop, factory, office, site) whose state's rules apply (FND-07).
  establishmentId   String?
  /// ACTIVE | ON_NOTICE | LEFT | SUSPENDED
  status        String  @default("ACTIVE")

  /// If this person also signs in, the account they sign in with.
  userId String?

  notes String?

  // ---- Personal (People app) -----------------------------------------
  firstName                String?
  lastName                 String?
  gender                   String? /// MALE | FEMALE | OTHER
  dateOfBirth              String? /// YYYY-MM-DD
  /// Phone punch: SITE (only inside a work site) or FIELD (anywhere, location and
  /// address recorded, marked outside a site; for sales, service and site staff).
  phonePunchMode           String    @default("SITE")
  /// A selfie must come with each phone punch (otherwise it is optional).
  selfieRequired           Boolean   @default(false)
  /// Withdrew agreement to CLOR keeping copies of their fingerprints / face (DPDP).
  biometricOptOutAt        DateTime?
  /// The employee privacy notice version they last read in the portal, and when.
  privacyNoticeVersion     String?
  privacyNoticeAckAt       DateTime?
  /// LX-07: personal data erased on this date (contact, address, biometrics, photos, notes, ID documents);
  /// what labour, tax and PF law keep (name, code, dates, attendance, pay) stays until its retention ends.
  anonymisedAt             DateTime?
  maritalStatus            String? /// SINGLE | MARRIED | DIVORCED | WIDOWED
  personalEmail            String?
  /// A small square image, resized client-side, stored as a data URL (as the
  /// platform does for avatars) — no object storage for a few kilobytes.
  photoUrl                 String?
  addressLine              String?
  city                     String?
  state                    String?
  country                  String?
  pincode                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // ---- Work (People app) ---------------------------------------------
  // Ids into the org-structure tables below. `department` and `designation`
  // above stay as the display strings every existing reader uses, and are
  // written alongside these.
  departmentId        String?
  /// Company master data (People → Settings → Company): business unit, grade, cost centre.
  businessUnitId      String?
  gradeId             String?
  costCenterId        String?
  jobPositionId       String?
  jobRoleId           String?
  employeeTypeId      String?
  workTypeId          String?
  /// FULL_TIME | PART_TIME; null means not said (read as full-time).
  hours               String?
  /// Another Employee in the same org; drives the org chart.
  reportingManagerId  String?
  /// A second, dotted-line manager (ORG-02): sees the person as a report, approves nothing by default.
  dottedManagerId     String?
  workEmail           String?
  workPhone           String?
  workLocation        String?
  /// The person's user ID on the biometric readers, when it is not their
  /// employee code (readers drop leading zeros; old enrolments used prefixes).
  devicePin           String?
  /// Attendance (ClorTime's personnel fields): the site they work at, the
  /// contractor that supplies them, and what the readers hold for them.
  areaId              String?
  contractorId        String?
  /// RFID card number on the readers.
  cardNumber          String?
  /// The PIN a person may type at a reader instead of a finger. Kept as the
  /// reader keeps it, so it can be copied to every reader.
  devicePassword      String?
  /// 0 user, 14 reader administrator.
  devicePrivilege     Int       @default(0)
  /// False for door-only staff (guards, drivers, a tenant's people): they open
  /// doors but are not expected at work, so are never marked absent.
  attendanceRequired  Boolean   @default(true)
  /// Father's or husband's name — the statutory muster roll asks for it.
  guardianName        String?
  /// When they left: RESIGNED | TERMINATED | RETIRED | ABSCONDED | CONTRACT_ENDED | DECEASED
  leavingType         String?
  leavingReason       String?
  /// When the resignation was received, and whether the notice owed was waived (Workforce final audit W15).
  resignedOn      String?
  noticeWaived    Boolean  @default(false)
  /// Employee portal (ClorTime's self-service): the person chooses their own
  /// password with a one-time activation code from HR; only hashes are kept,
  /// so nobody else ever knows it.
  portalEnabled       Boolean   @default(false)
  portalPasswordHash  String?
  portalPasswordSetAt DateTime?
  portalSetupHash     String?
  portalSetupExpires  DateTime?
  /// When every portal sign-in was last ended (suspended, left, "sign out
  /// everywhere"): a token from before the session registry issued earlier is refused (A-33).
  portalSessionsRevokedAt DateTime?
  /// May punch from a phone (inside a geofence). Off unless HR allows it.
  mobilePunch         Boolean   @default(false)
  /// Only this site counts for their phone punches; null = any active site.
  geofenceId          String?
  probationEndDate    String?
  contractEndDate     String?

  tags      EmployeeTagLink[]
  notesLog  EmployeeNote[]
  documents EmployeeDocument[]
  episodes  EmploymentEpisode[]

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, code])
  /// One login is one person in a company (team scope, self-service and manager approvals read it).
  @@unique([orgId, userId])
  @@unique([orgId, devicePin])
  @@index([accountId, orgId, areaId])
  @@index([accountId, orgId, contractorId])
  @@index([accountId, orgId, status])
  @@index([accountId, orgId, branchId])
  @@index([accountId, orgId, departmentId])
  @@index([accountId, orgId, establishmentId])
  @@index([accountId, orgId, reportingManagerId])
  joinInvites JoinInvite[]
  /// Team and seat (ORG-01, ORG-04); a seat holds one person at a time.
  teamId String?
  seatId String?
  deskRequests DeskRequest[]

  @@unique([orgId, seatId])
}

// ============================================================================
// Org structure (People app) — after Horilla's base: Department, JobPosition,
// JobRole, EmployeeType, WorkType. Per org; names unique within it.
// ============================================================================

model Department {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  /// A sub-department points at its parent; null = top level.
  parentId    String?
  description String?
  isActive    Boolean @default(true)
  /// Who runs it (Organization, D04): descriptive only, never a permission.
  headEmployeeId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

model JobPosition {
  id           String  @id @default(cuid())
  accountId    String
  orgId        String
  departmentId String?
  name         String
  description  String?
  isActive     Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId, departmentId])
}

model JobRole {
  id            String  @id @default(cuid())
  accountId     String
  orgId         String
  jobPositionId String?
  name          String
  description   String?
  isActive      Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, jobPositionId, name])
  @@index([accountId, orgId, jobPositionId])
}

/// Permanent, Probation, Contract, Intern, Consultant…
model EmployeeType {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  name      String
  /// What CLOR understands the name to mean: PERMANENT | FIXED_TERM | TRAINEE | INTERN | CONSULTANT | AGENCY.
  /// The company keeps its own words ("Staff", "Retainer"); the kind decides which dates are asked and
  /// whether payroll expects them.
  category  String  @default("PERMANENT")
  /// How long probation runs for this type, in months; fills the date on a new hire. Blank: not assumed.
  probationMonths Int?
  /// Notice the person owes when they resign, in days; the leaving form works out any shortfall. Blank: not assumed.
  noticeDays      Int?
  isActive  Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// Where someone works from (shown as Work mode): Office, Remote, Hybrid, Field…
model WorkType {
  id        String  @id @default(cuid())
  accountId String
  orgId     String
  name      String
  isActive  Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

model EmployeeTag {
  id        String @id @default(cuid())
  accountId String
  orgId     String
  name      String
  /// Hex colour for the chip.
  color     String @default("#E54F38")

  createdByUserId String
  createdAt       DateTime @default(now())

  links EmployeeTagLink[]

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

model EmployeeTagLink {
  id         String @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  tagId      String

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tag      EmployeeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([employeeId, tagId])
  @@index([accountId, orgId, tagId])
}

/// A dated note on a person's file (HR remarks, conversations, follow-ups).
model EmployeeNote {
  id         String @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  body       String

  createdByUserId String
  createdAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([accountId, orgId, employeeId])
}

// ============================================================================
// Attendance (native, after Horilla HRMS's attendance and base shift models).
// Lives in the HR database beside the people it is about. Times are stored as
// instants (UTC); the working day and the shift clock are Indian Standard Time.
// ============================================================================

/// A working pattern: when the day starts and ends, the break, how late is
/// late, how long counts as a half or full day, and which weekdays are off.
model Shift {
  id                   String  @id @default(cuid())
  accountId            String
  orgId                String
  name                 String
  /// "HH:MM", IST. An end at or before the start is a night shift.
  startTime            String
  endTime              String
  breakMinutes         Int     @default(60)
  /// Arriving within this many minutes of the start is not late.
  graceMinutes         Int     @default(10)
  /// Leaving within this many minutes of the end is not early.
  earlyOutGraceMinutes Int     @default(0)
  halfDayMinutes       Int     @default(240)
  fullDayMinutes       Int     @default(480)
  /// Worked minutes beyond this are overtime; null = the full day.
  overtimeAfterMinutes Int?
  /// Weekdays off, 0 = Sunday … 6 = Saturday, comma separated ("0" or "0,6").
  weeklyOffDays        String  @default("0")
  /// Which Saturdays of the month are off on top of weeklyOffDays, e.g. "2,4"
  /// for the second and fourth (ClorTime's nth-Saturday rule).
  offSaturdays         String  @default("")
  /// A short code for schedule grids ("G", "N1") and a colour for them.
  code                 String?
  color                String?
  isActive             Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// Which shift a person works, from a date. The latest one on or before a day
/// applies; a change of shift is a new row, so past days keep theirs.
model ShiftAssignment {
  id            String  @id @default(cuid())
  accountId     String
  orgId         String
  employeeId    String
  shiftId       String
  effectiveFrom String /// YYYY-MM-DD
  /// Last day, inclusive; null = until changed.
  effectiveTo   String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([employeeId, effectiveFrom])
  @@index([accountId, orgId, employeeId])
}

model Holiday {
  id         String  @id @default(cuid())
  accountId  String
  orgId      String
  date       String /// YYYY-MM-DD
  name       String
  /// Restricted/optional holiday: shown, but a working day unless taken as leave.
  isOptional Boolean @default(false)
  /// Null = every branch.
  branchId   String?
  /// Null = the whole company; set = only people in that area (ClorTime's
  /// holiday locations: a plant in another state keeps its own holidays).
  areaId     String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([orgId, date, name])
  @@index([accountId, orgId, date])
}

/// One person, one day.
model AttendanceRecord {
  id         String    @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  date       String /// YYYY-MM-DD, the day the shift starts
  shiftId    String?
  checkIn    DateTime?
  checkOut   DateTime?

  workedMinutes    Int     @default(0)
  lateMinutes      Int     @default(0)
  earlyOutMinutes  Int     @default(0)
  overtimeMinutes  Int     @default(0)
  overtimeApproved Boolean @default(false)

  /// PRESENT | HALF_DAY | ABSENT | ON_LEAVE | HOLIDAY | WEEKLY_OFF
  status String
  /// CLOCK | MANUAL | REQUEST | LEAVE | DEVICE | IMPORT
  source String @default("MANUAL")

  /// The approved leave that wrote this day, if any (its type says paid or unpaid).
  leaveRequestId String?
  /// How the day was worked when not at the usual place: WFH | ON_DUTY; PERMISSION when hours were excused. From an approved attendance request.
  dayKind        String?
  attendanceRequestId String?

  /// Checked by a manager (Horilla's "validate"). Payroll reads validated days.
  validated         Boolean   @default(false)
  validatedByUserId String?
  validatedAt       DateTime?
  note              String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([accountId, orgId, date])
  @@index([accountId, orgId, employeeId, date])
}

/// Each clock-in and clock-out as it happened; the record keeps the day's
/// first in and last out.
model AttendanceActivity {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  at         DateTime
  /// IN | OUT
  kind       String
  /// CLOCK | DEVICE
  source     String   @default("CLOCK")
  ip         String?

  createdAt DateTime @default(now())

  @@index([accountId, orgId, employeeId, at])
}

/// A correction someone asks for: "I was here 09:05–18:10 on the 3rd".
model AttendanceRequest {
  id         String    @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  date       String
  checkIn    DateTime?
  checkOut   DateTime?
  reason     String
  /// PENDING | APPROVED | REJECTED
  status     String    @default("PENDING")

  requestedByUserId   String
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewNote          String?
  /// The manager's step, when the company asks for it before HR (AttendanceSettings.*Approval).
  managerApprovedAt   DateTime?
  managerApprovedById String?
  /// The day as it stood when the request was made, so a reviewer sees what changes.
  beforeCheckIn       DateTime?
  beforeCheckOut      DateTime?
  beforeStatus        String?
  /// A category for the reason: FORGOT_PUNCH | READER_DOWN | ON_DUTY | WRONG_SHIFT | OTHER
  reasonCode          String?
  /// What is asked for: MISSED_PUNCH (a correction, the default) | WFH | ON_DUTY | PERMISSION (hours off).
  kind                String    @default("MISSED_PUNCH")
  /// WFH and On duty may span days; null = the one date.
  toDate              String?
  /// On duty: where (a client, a site, a city).
  place               String?
  /// Permission: how long, in minutes, between checkIn and checkOut.
  minutes             Int?
  /// A half day of WFH or On duty: FIRST or SECOND half.
  halfDay             String?
  managerNote         String?
  history             Json      @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, orgId, status])
  @@index([accountId, orgId, employeeId, date])
}

/// A stand-in for a manager's approvals while they are away (leave and
/// attendance requests of their team), between two dates. Set by HR or by
/// the manager themselves; the stand-in decides as the manager would.
model ApprovalStandIn {
  id                String   @id @default(cuid())
  accountId         String
  orgId             String
  managerEmployeeId String
  standInEmployeeId String
  fromDate          String
  toDate            String
  createdByUserId   String
  createdAt         DateTime @default(now())

  @@index([orgId, managerEmployeeId, fromDate, toDate])
}

/// A restricted (optional) holiday a person chose for a year, within the
/// company's quota (AttendanceSettings.restrictedHolidayQuota). The day is a
/// holiday for them alone.
model HolidayPick {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  holidayId  String
  year       Int
  createdAt  DateTime @default(now())

  @@unique([employeeId, holidayId])
  @@index([orgId, employeeId, year])
}

/// One run of the leave year-end: what carried, lapsed and was paid out per
/// person and type, so it can be read back and undone until payroll takes it.
model LeaveYearEnd {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  /// The leave period that closed (named by the year it started in).
  year          Int
  summaryJson   String
  ranByUserId   String
  ranAt         DateTime  @default(now())
  undoneAt      DateTime?
  undoneByUserId String?

  @@index([orgId, year])
}

/// A kind of leave: casual, sick, earned, loss of pay…
model LeaveType {
  id         String  @id @default(cuid())
  accountId  String
  orgId      String
  name       String
  code       String?
  /// Unpaid leave is loss of pay in the month summary.
  isPaid     Boolean @default(true)
  /// Days a year each person gets unless their allocation says otherwise.
  /// Ignored for unpaid leave, which has no balance.
  annualDays Float   @default(0)
  isActive   Boolean @default(true)

  /// YEARLY: the year's days are there from 1 January. MONTHLY: a twelfth is
  /// credited at the start of each month.
  accrual           String  @default("YEARLY")
  /// Someone joining during the year gets the months left (joining after the
  /// 15th counts from the next month).
  prorateForJoiners Boolean @default(false)
  /// Days of an unused balance taken into the next year; null lets it lapse.
  carryForwardMax   Float?

  // The policy HR sets (founder, 22 Oct 2026: the full leave module in HR).
  // Each default keeps the type working the way it did before these existed.
  description        String?
  /// A colour for the leave calendar, #rrggbb.
  color              String?
  allowHalfDay       Boolean  @default(true)
  /// Days ahead someone must ask (their own request; HR entering it is not held to it). Null = any time.
  minNoticeDays      Int?
  /// Longest single request, in days (up to 182, 26 weeks). Null = no limit beyond the 60-day span; above 60 it is also the span.
  maxDaysPerRequest  Float?
  /// How far back someone may ask for leave they already took. Null = no limit.
  backdatedDays      Int?
  /// Days the balance may go below zero (advance leave).
  negativeDays       Float    @default(0)
  /// FEMALE | MALE: maternity, paternity. Null = everyone.
  gender             String?
  /// Only these employee types; empty = every type.
  employeeTypeIds    String[] @default([])
  /// Usable this many days after joining (probation). Null = from joining.
  availableAfterDays Int?
  /// Sandwich rule: weekly offs and holidays inside a request count as leave.
  sandwich           Boolean  @default(false)
  /// Private leave (sick, medical, maternity): the reason is optional and only
  /// those who decide leave read it; the calendar and the team see "Away".
  isPrivate          Boolean  @default(false)
  /// Days a year by who the person is, over the type's own annualDays:
  /// [{ employeeTypeId?: string, minServiceMonths?: number, annualDays: number }].
  /// The most specific rule that fits wins (employee type and service over
  /// service alone over employee type alone), read as of the period start or
  /// the joining date, whichever is later.
  entitlements       Json     @default("[]")
  /// Rules added to a type already in use apply from this period start (ISO date); earlier periods keep annualDays.
  entitlementsFrom   String?
  /// During probation: ACCRUE as normal, HOLD (credits start at confirmation),
  /// or LOCK (credits build but cannot be taken until confirmation).
  probationRule      String   @default("ACCRUE")
  /// This type's own approval chain (HR | MANAGER | MANAGER_THEN_HR); null = the company's.
  approval           String?
  /// A person's own request of up to this many days, within their balance, is approved as it is sent.
  autoApproveUpToDays Float?
  /// A step that waits longer than this many days is handed on to HR. Null = never.
  handOnAfterDays    Int?
  /// Unused days may be paid out, up to this many a year.
  encashable         Boolean  @default(false)
  maxEncashDays      Float?
  /// When each credit lands (accrual is YEARLY, HALF_YEARLY, QUARTERLY or MONTHLY):
  /// START of each part of the leave period, its END, or DAY — the first
  /// creditDay (1–28) on or after the part begins.
  creditOn           String   @default("START")
  creditDay          Int?
  /// Statutory leave (TIME-LEAVE-MARKET-RESEARCH.md, G1–G3). Each is opt-in; the defaults keep a type as it was.
  /// CALENDAR: annualDays, credited as above. PER_DAYS_WORKED: one day for every perDaysWorked days worked in the
  /// previous leave period, credited at this period's start, when that period's days worked reach minDaysWorked
  /// (OSH Code s.32: 1 per 20 after 180; Factories Act s.79: 1 per 20 after 240).
  accrualBasis       String   @default("CALENDAR")
  perDaysWorked      Float?
  minDaysWorked      Float?
  /// OSH Code carry-forward: carry up to carryForwardMax, plus the days of this type asked for and refused in the
  /// period; what is over is paid out by the year end's run.
  oshCarry           Boolean  @default(false)
  /// Every date inside a request is a leave day, weekly offs and holidays included (maternity).
  countsCalendarDays Boolean  @default(false)
  /// JOINING: availableAfterDays counts calendar days from joining. DAYS_WORKED: days worked in the 12 months
  /// before the leave starts (Code on Social Security, maternity: 80).
  availableAfterBasis String  @default("JOINING")

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// One person's days of one leave type for one calendar year, when it
/// differs from the type's annual days (joiners, carry-over, grants).
model LeaveAllocation {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  employeeId  String
  leaveTypeId String
  year        Int
  days        Float
  note        String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([accountId, orgId, year])
}

/// Days added to or taken from one person's balance of one type in one year,
/// with the reason: a correction, a grant, an opening balance brought from
/// another system, or days paid out (ENCASH, a debit). Kept as a ledger, so
/// every balance can be explained line by line.
model LeaveAdjustment {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  employeeId  String
  leaveTypeId String
  year        Int
  /// Positive adds days, negative takes them away.
  days        Float
  /// ADJUST | ENCASH
  kind        String  @default("ADJUST")
  reason      String
  /// Set when Payroll pays an encashment.
  paidInRunId String?

  createdByUserId String
  /// A comp-off grant names the date worked; a year-end pay-out names its run.
  workedOn        String?
  yearEndId       String?
  createdAt       DateTime @default(now())

  @@index([accountId, orgId, year])
  @@index([orgId, employeeId, leaveTypeId])
}

/// Time off someone asks for. Approving it marks each working day on leave.
model LeaveRequest {
  id          String @id @default(cuid())
  accountId   String
  orgId       String
  employeeId  String
  leaveTypeId String
  fromDate    String /// YYYY-MM-DD
  toDate      String /// YYYY-MM-DD, inclusive
  /// Working days in the range (weekly offs and holidays are not counted); 0.5 for a half day.
  days        Float
  /// Half-day leave on a single day: FIRST or SECOND half. Null = whole days.
  halfDay     String?
  reason      String
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status      String @default("PENDING")

  requestedByUserId   String
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewNote          String?
  /// The manager's step, when the company asks for it before HR (AttendanceSettings.*Approval).
  managerApprovedAt   DateTime?
  managerApprovedById String?
  /// The manager's note with their step; HR's decision note is reviewNote.
  managerNote         String?
  /// What happened to the request, in order: [{ at, by, what, note?, from?, to? }] (edits, steps, hand-ons, decisions).
  history             Json      @default("[]")
  /// Set when the request was approved by its own rule (autoApproveUpToDays), not by a person.
  autoApproved        Boolean   @default(false)
  /// Leave that crosses the leave-period end is saved as one request per
  /// period; the parts share this id so they read, and cancel, as one.
  groupId             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, orgId, status])
  @@index([accountId, orgId, employeeId, fromDate])
  @@index([orgId, fromDate, toDate])
}

/// A biometric reader (ZKTeco / eSSL) that pushes punches to /iclock. The
/// company claims it by serial number; a serial belongs to one company.
model AttendanceDevice {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  serialNumber    String    @unique
  name            String
  /// both | in | out. A reader at the entrance only is "in": its punches are
  /// entries whatever key was pressed.
  direction       String    @default("both")
  isActive        Boolean   @default(true)
  model           String?
  firmware        String?
  ip              String?
  lastSeenAt      DateTime?
  /// From the reader's INFO and from face templates it sends. A face is
  /// copied to a reader with that reader's own algorithm version.
  faceSupported   Boolean?
  fingerSupported Boolean?
  faceMajorVer    Int?
  faceMinorVer    Int?
  /// ADMS: a reader pushing to /iclock. ETIMEOFFICE: eSSL's e-Time Office
  /// cloud, which CLOR pulls punches from (the serial is "ETO-<account>").
  /// Which driver speaks to it (services/attendance/drivers.ts): ADMS,
  /// ETIMEOFFICE, API, HTTP_PUSH, FILE, and the pull drivers as they arrive.
  vendor          String    @default("ADMS")
  /// HTTP_PUSH: the reader's own push URL token, kept as a hash (prefix shown).
  pushTokenHash   String?   @unique
  pushTokenPrefix String?
  /// HTTP_PUSH / FILE / pull drivers: where each field is in what they send
  /// (services/attendance/punchMapping.ts).
  mappingJson     String?
  /// Driver settings that are not secrets (host, port, event filters).
  configJson      String?
  /// The zone times without an offset are read in.
  sourceTimezone  String    @default("Asia/Kolkata")
  /// The last thing it sent, trimmed, so a mapping can be checked against it.
  lastPayload     String?
  lastPayloadAt   DateTime?
  apiUrl          String?
  apiCorporateId  String?
  apiUsername     String?
  /// Encrypted (AES-256-GCM, services/mailer.ts encryptSecret); never sent to the browser.
  apiSecret       String?
  /// Punches are pulled from here on (with a few minutes' overlap; duplicates drop).
  lastFetchedAt   DateTime?
  lastError       String?
  /// Pull readers on the office LAN: the on-site connector that reaches them (routes/agent.ts); null = CLOR pulls directly.
  agentId         String?
  /// Readers of one site: only staff of this area are sent to it (null = everyone).
  areaId          String?
  /// What the reader holds and can hold, from its answer to INFO (asked every few hours).
  userCount       Int?
  fingerCount     Int?
  faceCount       Int?
  punchCount      Int?
  maxUsers        Int?
  maxFingers      Int?
  maxFaces        Int?
  maxPunches      Int?
  mac             String?
  infoAt          DateTime?
  /// How far the reader's clock is from true time (seconds; + = reader ahead),
  /// measured from punches it sent the moment they were made.
  clockOffsetSec  Int?
  clockCheckedAt  DateTime?

  /// The network lock. A reader is known by its serial number alone, so the one
  /// thing that cannot be faked is the internet address its requests come from.
  /// Data is taken only from approved addresses, and an address is approved
  /// only by an admin on that same network (adding the reader, or "approve")
  /// — another company that claims the serial can never approve this one's.
  allowedNetworks   String[]  @default([])
  /// Set once the company proved it is on the reader's network (or for readers
  /// added before the lock existed, which keep the first network they call from).
  networkVerifiedAt DateTime?
  /// The address the reader was added from, approved if the reader calls in from it.
  claimNetwork      String?
  /// An address the reader is calling from that is not approved (yet).
  pendingNetwork    String?
  pendingNetworkAt  DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId])
}

/// A month HR has closed: its days are final, and what Payroll takes from
/// Attendance cannot move under it. Reopening deletes the row.
model AttendanceMonthLock {
  id             String   @id @default(cuid())
  accountId      String
  orgId          String
  /// YYYY-MM
  month          String
  lockedByUserId String
  lockedAt       DateTime @default(now())

  @@unique([orgId, month])
  @@index([accountId, orgId])
}

/// A punch exactly as a reader sent it. The day is worked out from these.
model DevicePunch {
  id           String   @id @default(cuid())
  accountId    String
  orgId        String
  deviceId     String
  serialNumber String
  /// The user ID on the reader.
  pin          String
  at           DateTime
  /// The reader's own wall-clock time, IST, "YYYY-MM-DD HH:mm:ss".
  localTime    String
  /// The reader's punch state (0 in, 1 out, 2-5 break/overtime, 255 unset).
  state        String
  /// IN | OUT, or null when neither the punch nor the reader says.
  kind         String?
  /// 1 finger, 15 face, 2 card…, as the reader reports it.
  verifyMode   Int      @default(0)
  /// The work code chosen at the reader (a job, a site); null when none.
  workCode     String?
  /// Null until the pin is matched to an employee.
  employeeId   String?
  /// The shift day the punch belongs to (a night shift's morning exit is the previous day).
  shiftDate    String?
  raw          String?
  /// Phone punches: where it was made, which site it matched, and the selfie.
  latitude     Float?
  longitude    Float?
  accuracyM    Float?
  geofenceId   String?
  photoId      String?
  /// A field punch made outside every work site, with the address of where it was made.
  outsideSite  Boolean  @default(false)
  address      String?
  /// Field punches waiting for a decision: PENDING (not counted yet), APPROVED, REJECTED. Null = counts.
  reviewStatus String?
  createdAt    DateTime @default(now())

  /// Per reader: two sites may give the same reader ID to different people
  /// (ReaderIdAtSite). The same person punching on two readers at once is
  /// dropped in ingestPunches by employee and time.
  @@unique([orgId, deviceId, pin, at])
  @@index([orgId, employeeId, at])
  @@index([accountId, orgId, employeeId, shiftDate])
  @@index([orgId, deviceId, at])
}

/// A command waiting for a reader's next heartbeat (ADMS "C:<id>:<command>").
model DeviceCommand {
  id              Int       @id @default(autoincrement())
  accountId       String
  orgId           String
  deviceId        String
  serialNumber    String
  command         String
  /// Sent lowest first: 1 user record, 2 delete, 3 template, 999 everything
  /// else — a reader rejects a template for a user it does not have yet.
  sequence        Int       @default(999)
  /// PENDING | SENT | DONE | FAILED | CANCELLED
  status          String    @default("PENDING")
  returnCode      Int?
  /// Times sent. A command the reader never answers is sent again, up to 3 times.
  attempts        Int       @default(0)
  lastError       String?
  sentAt          DateTime?
  doneAt          DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([serialNumber, status])
  @@index([deviceId, status, sequence])
  @@index([accountId, orgId, deviceId])
}

/// The users a reader holds, as it last reported them (DATA QUERY USERINFO).
model DeviceUser {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  deviceId  String
  pin       String
  name      String?
  /// As the reader holds them; copied with the user to the other readers so a
  /// card or door PIN set on one reader works on all.
  privilege Int?
  password  String?
  card      String?
  /// What this reader holds for the person, as far as CLOR knows: finger
  /// numbers ("0,6") and whether a face — from what the reader sent, and from
  /// commands it confirmed.
  fingers   String   @default("")
  face      Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([deviceId, pin])
  @@index([accountId, orgId])
}

/// A serial that reached /iclock but no company has claimed. No tenant: it is
/// only there so "Add reader" can say the reader is already talking to us.
model UnclaimedReader {
  serialNumber String   @id
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  ip           String?
  /// The internet address its requests came from (ip may be the LAN one it reports).
  network      String?
  info         String?
}

/// A fingerprint or face as a reader enrolled it, kept so it can be copied to
/// the company's other readers. Biometric data: never sent to the browser,
/// deleted (and removed from the readers) when the person leaves.
/// A person's reader ID at one site, when it is not their company-wide one
/// (Employee.devicePin, else their code). Companies that grew site by site
/// often have 105 at the factory and 105 at the depot as two people: each
/// site's readers know their own 105. Readers with no site use company IDs.
model ReaderIdAtSite {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  employeeId      String
  areaId          String
  pin             String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, areaId, pin])
  @@unique([orgId, areaId, employeeId])
  @@index([orgId, employeeId])
}

model BiometricTemplate {
  id             String   @id @default(cuid())
  accountId      String
  orgId          String
  /// "" when the ID is the company-wide one; a site (area) id when the reader
  /// ID belongs to someone only at that site (ReaderIdAtSite).
  scope          String   @default("")
  /// The user ID on the reader.
  pin            String
  employeeId     String?
  /// 1 fingerprint, 9 face (visible light); other BIODATA types kept as sent.
  type           Int
  /// Finger index or face number.
  no             Int      @default(0)
  data           String
  valid          Int      @default(1)
  duress         Int      @default(0)
  majorVer       Int      @default(0)
  minorVer       Int      @default(0)
  format         Int      @default(0)
  indexNo        Int      @default(0)
  sourceDeviceId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orgId, scope, pin, type, no])
  @@index([accountId, orgId, employeeId])
}

/// What a reader reports about itself: operations done at the reader
/// (enrolments, deletions, menu access — OPERLOG "OPLOG" lines) and errors
/// (ERRORLOG). ClorTime's Operation Log and Error Log.
model DeviceLog {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  deviceId  String
  /// OPERATION | ERROR
  kind      String
  /// The operation type or error code, as the reader numbers it.
  code      String
  /// Who did it at the reader (admin user ID), when given.
  operator  String?
  /// The reader's wall clock, "YYYY-MM-DD HH:mm:ss".
  localTime String
  details   String?
  createdAt DateTime @default(now())

  @@index([accountId, orgId, deviceId, localTime])
  @@index([orgId, kind, localTime])
}

/// A key an outside system uses to call CLOR's API (an HRMS pulling
/// attendance, middleware pushing punches). Only a SHA-256 hash is kept; the
/// key is shown once when issued or rotated (ClorTime routes/api_clients.js).
model ApiClient {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  name            String
  tokenHash       String    @unique
  /// The first characters, to recognise a key in lists and logs.
  tokenPrefix     String
  /// Comma separated: attendance:read, employees:read, punches:write
  scopes          String
  /// Comma separated addresses the key may be used from; null = anywhere.
  allowedIps      String?
  isActive        Boolean   @default(true)
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  lastUsedIp      String?
  /// The reader row punches pushed with this key are recorded under.
  deviceId        String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId, orgId])
}

/// Where CLOR sends events (punches, days) as they happen, signed with HMAC.
model Webhook {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  name            String
  url             String
  /// Encrypted (encryptSecret); shown once when created.
  secret          String
  /// The secret before the last change, encrypted; still signed with until previousSecretUntil (A-34).
  previousSecret      String?
  previousSecretUntil DateTime?
  /// Comma separated: punch, day
  events          String
  isActive        Boolean   @default(true)
  lastStatus      Int?
  lastError       String?
  lastDeliveredAt DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId, orgId])
}

/// One attempt-set at sending one event to one webhook: what was sent, how
/// it went, when it is tried again. Kept so a missed event can be seen and
/// sent again from the Integrations screen.
model WebhookDelivery {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  webhookId     String
  event         String
  /// The JSON body as sent (signature is over exactly this), trimmed at 20k.
  body          String
  /// PENDING | OK | FAILED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastStatus    Int?
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([orgId, webhookId, createdAt])
  @@index([status, nextAttemptAt])
}

/// A write to the public API repeated with the same Idempotency-Key gets the
/// same answer instead of a second employee or a second leave request.
model ApiIdempotency {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  clientId  String
  key       String
  method    String
  path      String
  /// SHA-256 of the request body: the same key with a different body is a mistake, not a retry.
  bodyHash  String
  status    Int
  body      String
  createdAt DateTime @default(now())

  @@unique([clientId, key])
  @@index([createdAt])
}

/// A site or zone people work at (ClorTime's Area): a plant, a branch office,
/// a floor. Areas nest; readers and holidays will hang off them.
model Area {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  parentId    String?
  description String?
  isActive    Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// A company that supplies workers (ClorTime's Contractors). Their people are
/// employees with contractorId set, so their attendance is recorded the same way.
model Contractor {
  id             String  @id @default(cuid())
  accountId      String
  orgId          String
  name           String
  code           String?
  contactPerson  String?
  phone          String?
  email          String?
  gstin          String?
  /// Contract Labour Act licence and its expiry.
  licenceNo      String?
  licenceValidTo String?
  address        String?
  isActive       Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// A different shift for a few days — cover, a training week, a night swap.
/// Wins over every other schedule for those days (ClorTime's temporary schedule).
model TemporarySchedule {
  id         String  @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  shiftId    String
  fromDate   String /// YYYY-MM-DD
  toDate     String /// YYYY-MM-DD, inclusive
  reason     String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([accountId, orgId, employeeId, fromDate])
}

/// The shift a whole department works from a date, for anyone in it without a
/// schedule of their own (ClorTime's department schedule).
model DepartmentSchedule {
  id            String  @id @default(cuid())
  accountId     String
  orgId         String
  departmentId  String
  shiftId       String
  effectiveFrom String
  effectiveTo   String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([departmentId, effectiveFrom])
  @@index([accountId, orgId])
}

/// A repeating pattern — week A days, week B nights — worked out for any date
/// from its anchor (ClorTime's shift rotations).
model ShiftRotation {
  id         String  @id @default(cuid())
  accountId  String
  orgId      String
  name       String
  /// Shift ids, one per period, comma separated; "OFF" = no rotation shift
  /// that period (the person's other schedules apply).
  sequence   String
  /// Days each step lasts: 7 weekly, 1 daily.
  periodDays Int     @default(7)
  /// The day step one starts; periods are counted from here.
  anchorDate String
  isActive   Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// Someone on a rotation. An offset starts them that many steps later, so two
/// crews on one two-step pattern cover both shifts every week.
model RotationAssignment {
  id         String  @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  rotationId String
  slotOffset Int     @default(0)
  startsOn   String
  endsOn     String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([employeeId, rotationId, startsOn])
  @@index([accountId, orgId, rotationId])
}

/// Company-wide attendance rules (ClorTime's Attendance Rules in Settings).
model AttendanceSettings {
  id                         String  @id @default(cuid())
  accountId                  String
  orgId                      String  @unique
  /// The shift anyone with no schedule at all works; null = 09:00–18:00, Sunday off.
  defaultShiftId             String?
  /// Late arrivals a month that cost nothing…
  lateAllowancePerMonth      Int     @default(0)
  /// …then every this many late arrivals is half a day's loss of pay (0 = never).
  latePenaltyEvery           Int     @default(0)
  /// Punch selfies are personal data (DPDP): kept this many days, then deleted;
  /// the punch itself stays (ClorTime purgePunchPhotos).
  photoRetentionDays         Int     @default(90)
  /// Reader alerts (ClorTime alerts.js): e-mailed once when a problem starts
  /// and once when it clears; off until someone is named.
  alertEmails                String?
  /// A reader silent this long is offline.
  offlineAlertMinutes        Int     @default(30)
  /// On a working day, no punch from any reader by this hour means collection is broken.
  noPunchAfterHour           Int     @default(11)
  /// Sync both ways (ClorTime): someone added at a reader whose ID matches no
  /// employee becomes one, named as on the reader. Off = they wait in Unmatched.
  readerUsersBecomeEmployees Boolean @default(true)
  /// Who decides leave and correction requests: HR (default), MANAGER (the person's "Reports to"), or MANAGER_THEN_HR (both, in that order).
  leaveApproval              String  @default("HR")
  correctionApproval         String  @default("HR")
  /// The company's leave period (People → Settings → Leave Policy): the day and
  /// month it starts, e.g. 1 April for April–March. A period is named by the
  /// year it starts in. Default 1 January, the calendar year.
  leavePeriodStartMonth      Int     @default(1)
  leavePeriodStartDay        Int     @default(1)
  /// The company's working week (People → Time & Leave): the weekly offs of
  /// anyone with no shift. Day numbers 0–6 (Sunday 0); offSaturdays names the
  /// Saturdays of a month that are off (e.g. "2,4") when 6 is not a weekly off.
  /// Shifts, when Attendance sets them, still decide for the people on them.
  weeklyOffDays              String  @default("0")
  offSaturdays               String  @default("")
  /// Attendance request rules (People → Settings → Request rules):
  /// { WFH: { on, quotaPerMonth, backDays, approval }, ON_DUTY: {...}, PERMISSION: { on, hoursPerMonth, maxMinutes, approval }, MISSED_PUNCH: { quotaPerMonth, backDays } }.
  requestRules               Json    @default("{}")
  /// Restricted holidays a person may pick a year from the optional list; 0 = none.
  restrictedHolidayQuota     Int     @default(0)

  /// DPDP (services/attendance/biometrics.ts): CLOR keeps and copies fingerprints and
  /// faces between readers only when the company switches this on, recording who
  /// confirmed that employees were told and agreed, and when. Off by default.
  biometricCopy              Boolean   @default(false)
  biometricCopyAt            DateTime?
  biometricCopyBy            String?
  /// The company's contact for personal-data questions and grievances (DPDP Rules:
  /// published business contact), shown in the employee privacy notice.
  privacyContactName         String?
  privacyContactEmail        String?
  privacyContactPhone        String?
  /// When the company last published its employee privacy notice (its version is
  /// the notice version CLOR shows).
  privacyNoticeAt            DateTime?
  /// Field punches (outside every work site) wait for a manager's or HR's approval before they count.
  fieldPunchApproval         Boolean   @default(true)
  /// Monthly confirmation: employees confirm (or dispute) their month by this day of the next month.
  confirmCutoffDay           Int       @default(3)
  /// Employees may ask for recorded overtime to be approved; and, when on, for comp-off
  /// (a day of the comp-off leave type for work on a weekly off or holiday).
  overtimeRequests           Boolean   @default(true)
  compOffEnabled             Boolean   @default(false)
  compOffLeaveTypeId         String?
  /// Who decides overtime and comp-off requests: HR | MANAGER | MANAGER_THEN_HR.
  overtimeApproval           String    @default("HR")

  updatedByUserId String
  updatedAt       DateTime @updatedAt
}

/// A work site for phone punches: a circle around a point (ClorTime's geofences).
model Geofence {
  id           String  @id @default(cuid())
  accountId    String
  orgId        String
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int     @default(200)
  /// The address it was found by, or what is at the pin; shown beside the name.
  address      String?
  /// Null = for anyone; set = only people in that area may use it.
  areaId       String?
  isActive     Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, orgId])
}

/// The selfie taken with a phone punch. In the database (Cloud Run has no
/// disk), small (resized on the phone), and deleted after the retention period.
model PunchPhoto {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  mime       String
  data       Bytes
  /// R2 plan: where the bytes are when they are not in `data` (then empty).
  storageKey String?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
}

/// A reader problem, open until it clears (ClorTime alert_state). One row per
/// problem per reader — "Back door offline" and "Main gate offline" are two —
/// so fixing one never hides the other, and nobody is mailed twice for one.
model ReaderAlert {
  id                 String    @id @default(cuid())
  accountId          String
  orgId              String
  /// e.g. "offline:<deviceId>", "clock:<deviceId>", "no-punches"
  key                String
  kind               String
  deviceId           String?
  /// critical | high | medium
  severity           String
  title              String
  details            String
  openedAt           DateTime  @default(now())
  resolvedAt         DateTime?
  /// When the "started" and "cleared" e-mails went, and why one did not.
  notifiedAt         DateTime?
  resolvedNotifiedAt DateTime?
  lastError          String?
  updatedAt          DateTime  @updatedAt

  @@index([orgId, resolvedAt])
  @@index([orgId, key, resolvedAt])
}

/// A file on an employee's record — ID proof, contract, certificate — kept in
/// the database like punch selfies, capped at 5 MB. Visible to the person in
/// the portal unless HR says otherwise.
model EmployeeDocument {
  id                String    @id @default(cuid())
  accountId         String
  orgId             String
  employeeId        String
  /// ID_PROOF | ADDRESS_PROOF | EDUCATION | CONTRACT | PAYSLIP | WORK_PERMIT | CERTIFICATE | OTHER
  kind              String
  title             String
  mime              String
  size              Int
  data              Bytes
  /// R2 plan: where the bytes are when they are not in `data` (then empty). Set by utils/peoplePrisma.ts.
  storageKey        String?
  /// When it stops being valid (a visa, a licence), YYYY-MM-DD.
  expiresOn         String?
  /// When HR was first told it is about to expire.
  expiryNotifiedAt  DateTime?
  /// The last reminder sent: 60, 30, 7 or 0 days before expiry (DOC-03), each once.
  expiryStage       Int?
  /// For a work permit or certificate: what the person may not do while it is lapsed (LIFE-08). Shown, not enforced.
  restrictsWork     String?
  /// Versions (DOC-02): replacing a file keeps the old one, pointed both ways. Lists show the newest only.
  version           Int       @default(1)
  supersedesId      String?
  supersededById    String?
  /// A letter issued from a template (DOC-04): which template and version made it.
  templateId        String?
  templateVersion   Int?
  /// Who can see it (docs/people/02-PRD.md DOC-01): EMPLOYEE_VISIBLE (the person and
  /// anyone with Documents VIEW) | HR_ONLY (Documents VIEW) | RESTRICTED (Documents EDIT)
  /// | CONFIDENTIAL (Confidential Documents VIEW). `visibleToEmployee` is kept in step
  /// (true only for EMPLOYEE_VISIBLE) because the employee app still reads it.
  classification    String    @default("EMPLOYEE_VISIBLE")
  visibleToEmployee Boolean   @default(true)
  uploadedByUserId  String
  createdAt         DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId, employeeId])
  @@index([orgId, expiresOn])
  @@index([orgId, supersededById])
}

/// Policies (docs/people/02-PRD.md POL-01..06; services/people/policies.ts): a
/// library entry with an owner; each version has effective dates and says who it
/// applies to. Publishing keeps earlier versions readable; nothing is overwritten.
model Policy {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  title           String
  /// LEAVE | HOURS | CONDUCT | TRAVEL | BENEFITS | IT | POSH | PRIVACY | OTHER
  category        String
  /// Privacy notices only (PRV-01): EMPLOYMENT | ATTENDANCE | PAYROLL | RECRUITMENT | MONITORING | BENEFITS | OTHER
  purpose         String?
  description     String?
  ownerUserId     String
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions PolicyVersion[]

  @@index([orgId, category])
}

model PolicyVersion {
  id                String    @id @default(cuid())
  accountId         String
  orgId             String
  policyId          String
  version           Int
  /// The text, or a document on file (an uploaded PDF).
  body              String?
  documentId        String?
  /// YYYY-MM-DD; effectiveTo is set when a later version takes over or the policy is retired.
  effectiveFrom     String
  effectiveTo       String?
  /// { establishmentIds?, states?, departmentIds?, employeeTypeIds?, gradeIds?, workTypeIds? } — every list given must match.
  appliesTo         Json
  needsAcceptance   Boolean   @default(false)
  /// { "hi": "...", "ta": "..." }: the same text in the languages the company enables (PRV-01). English is `body`.
  translations      Json?
  /// DRAFT | WAITING | PUBLISHED | RETIRED
  status            String    @default("DRAFT")
  publishedAt       DateTime?
  publishedByUserId String?
  requestId         String?
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([orgId, status, effectiveFrom])
}

/// Someone was asked to read and accept a policy version or a document (DOC-05,
/// POL-04; services/people/acknowledgements.ts). One row per person per target.
model Acknowledgement {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  /// DOCUMENT | POLICY_VERSION
  targetType    String
  targetId      String
  employeeId    String
  askedAt       DateTime  @default(now())
  askedByUserId String?
  acceptedAt    DateTime?
  remindedAt    DateTime?
  remindCount   Int       @default(0)

  @@unique([targetType, targetId, employeeId])
  @@index([orgId, employeeId, acceptedAt])
  @@index([orgId, targetType, targetId])
}

/// Help desk (docs/people/02-PRD.md DESK-01..06; services/people/desk.ts). A
/// request from an employee with a thread; internal notes the employee never
/// sees; a category sets the queue and the reply-by and resolve-by times.
model DeskCategory {
  id          String   @id @default(cuid())
  accountId   String
  orgId       String
  key         String
  label       String
  queue       String
  leadUserId  String?
  replyHours  Int      @default(24)
  resolveDays Int      @default(3)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, key])
}

model DeskRequest {
  id                 String    @id @default(cuid())
  accountId          String
  orgId              String
  employeeId         String
  category           String
  subject            String
  description        String
  /// LOW | NORMAL | HIGH | URGENT
  urgency            String    @default("NORMAL")
  /// APP | EMAIL | PHONE
  replyChannel       String?
  assigneeUserId     String?
  queue              String
  replyBy            DateTime
  resolveBy          DateTime
  firstReplyAt       DateTime?
  replyEscalatedAt   DateTime?
  resolveEscalatedAt DateTime?
  /// OPEN | WAITING_EMPLOYEE | RESOLVED | REOPENED | MOVED
  status             String    @default("OPEN")
  resolution         String?
  resolvedAt         DateTime?
  resolvedByUserId   String?
  reopenedAt         DateTime?
  /// Moved to Private cases (DESK-05): the details here are wiped; only the date and the case stay.
  movedToCaseAt      DateTime?
  movedToCaseId      String?
  /// Raised from the Why panel (TRACE-03): the change it is about (a change-log correlation id or history_<id>).
  changeRef          String?
  raisedByUserId     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  messages DeskMessage[]

  @@index([orgId, status, resolveBy])
  @@index([orgId, employeeId])
  @@index([orgId, queue, status])
}

model DeskMessage {
  id               String   @id @default(cuid())
  accountId        String
  orgId            String
  requestId        String
  authorUserId     String?
  authorEmployeeId String?
  body             String
  /// Never returned to the employee (DESK-02).
  internal         Boolean  @default(false)
  attachmentDocId  String?
  templateId       String?
  /// The policy version an answer cites (DESK-06).
  policyVersionId  String?
  createdAt        DateTime @default(now())

  request DeskRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([orgId, requestId, createdAt])
}

model DeskTemplate {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  title           String
  body            String
  category        String?
  policyId        String?
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId, isActive])
}

/// Custom fields on a person (docs/people/02-PRD.md CORE-08; services/people/customFields.ts):
/// typed, with who may see and who may edit; every change to a definition is a
/// new version, and a value records the version it was saved under.
model CustomFieldDef {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  entity          String   @default("Employee")
  /// snake_case, never changed once made
  key             String
  label           String
  /// TEXT | NUMBER | DATE | CHOICE | BOOLEAN | FILE
  type            String
  /// For CHOICE: ["Option", …]
  options         Json?
  required        Boolean  @default(false)
  /// A permission key, e.g. PEOPLE::Employees::VIEW or PEOPLE::Statutory Details::VIEW
  viewPermission  String
  editPermission  String
  help            String?
  version         Int      @default(1)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  values CustomFieldValue[]

  @@unique([orgId, entity, key])
}

model CustomFieldValue {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  defId           String
  entityId        String
  value           Json?
  defVersion      Int      @default(1)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  def CustomFieldDef @relation(fields: [defId], references: [id], onDelete: Cascade)

  @@unique([defId, entityId])
  @@index([orgId, entityId])
}

/// One import, remembered (docs/people/02-PRD.md CORE-07): who it made and what it
/// changed (with the values before), so the whole batch can be undone within a day.
model ImportBatch {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  /// CREATE | UPDATE
  mode            String    @default("CREATE")
  rows            Int       @default(0)
  failed          Int       @default(0)
  /// employee ids this import created
  createdIds      Json
  /// [{ id, before: { field: value } }] for people this import changed
  updated         Json
  createdByUserId String?
  createdAt       DateTime  @default(now())
  undoneAt        DateTime?
  undoneByUserId  String?

  @@index([orgId, createdAt])
}

/// Company-wide People settings (docs/people/02-PRD.md CORE-03; decision D-02): one row per company.
model PeopleSetting {
  id                 String   @id @default(cuid())
  accountId          String
  orgId              String   @unique
  /// CONTACT_DIRECT (contact details save at once, the rest needs HR approval) | ALL (everything needs approval) | NONE (saves at once, HR told)
  selfServiceChanges String   @default("CONTACT_DIRECT")
  /// Languages privacy notices are offered in besides English (PRV-01), e.g. ["hi","ta"].
  noticeLanguages    Json?
  /// People Home's setup list (services/people/setup.ts): { skipped: [step], hidden: ISO, recorded: [step], simpleAdvice: ISO }.
  setupState         Json?
  updatedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// A team under a department, with a lead (docs/people/02-PRD.md ORG-01).
model Team {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  name            String
  departmentId    String?
  leadEmployeeId  String?
  description     String?
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seats Seat[]

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// An approved seat on a team (ORG-04): a designation and a budget reference; filled by the person whose `seatId` points here, or open.
model Seat {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  name            String
  teamId          String?
  jobPositionId   String?
  budgetRef       String?
  description     String?
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId, teamId])
}

/// A compliance rule as the company holds it (docs/people/02-PRD.md COMP-01;
/// services/people/complianceRules.ts): seeded from CLOR's catalogue, then the
/// company's own. Every edit is a new version; nothing is overwritten. A rule is
/// "checked" when a named person has confirmed it with their adviser (COMP-05).
model ComplianceRule {
  id                 String    @id @default(cuid())
  accountId          String
  orgId              String
  /// stable, e.g. IN-POSH-IC, IN-KA-SE-REG
  ruleId             String
  version            Int       @default(1)
  title              String
  /// IN (central) or IN-<state>, e.g. IN-KA
  jurisdiction       String
  /// ["SHOP","OFFICE",…] or [] for any
  establishmentKinds Json
  /// ["ALL"] or a list of employee types the rule reaches
  employeeCategories Json
  legalSource        String
  notificationRef    String?
  effectiveFrom      String
  effectiveTo        String?
  supersedesVersion  Int?
  obligation         String
  /// { minHeadcount?: number }
  threshold          Json?
  ownerRole          String    @default("HR")
  /// { kind: "MONTHLY", day } | { kind: "ANNUAL", month, day } | { kind: "HALF_YEARLY", months, day } | { kind: "ONCE", days } | { kind: "EVENT", after, days }
  dueRule            Json
  requiredProof      Json
  /// DRAFT | CHECKED | NEEDS_REVIEW
  reviewStatus       String    @default("DRAFT")
  checkedByUserId    String?
  checkedAt          DateTime?
  active             Boolean   @default(true)
  createdByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([orgId, ruleId, version])
  @@index([orgId, active])
}

/// What the company owes, worked out from its establishments and headcount (COMP-02).
model Obligation {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  ruleId          String
  ruleVersion     Int
  establishmentId String?
  /// the month, year or event the obligation is for, e.g. 2026-11, 2026, EST:<id>
  period          String
  title           String
  dueOn           String
  ownerUserId     String?
  /// UPCOMING | DUE | OVERDUE | DONE | CHECKED
  status          String    @default("UPCOMING")
  proofDocIds     Json
  note            String?
  dueToldAt       DateTime?
  doneAt          DateTime?
  doneByUserId    String?
  checkedAt       DateTime?
  checkedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([orgId, ruleId, establishmentId, period])
  @@index([orgId, status, dueOn])
}

/// A Health check item put aside until a date, with the reason (HLTH-03). It comes back on its date; the history stays.
model HealthSnooze {
  id        String    @id @default(cuid())
  accountId String
  orgId     String
  checkId   String
  reason    String
  /// YYYY-MM-DD the item comes back
  until     String
  byUserId  String?
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([orgId, checkId, until])
}

/// A private case (docs/people/02-PRD.md PRIV-01..06; services/people/privateCases.ts): a POSH
/// complaint or a grievance. Only its named members open it — not company admins unless named.
/// The summary and evidence are encrypted with PEOPLE_CASE_KEY (D-09); every open is logged.
/// Never in search, exports, reports or AI (PRIV-04).
model PrivateCase {
  id                    String   @id @default(cuid())
  accountId             String
  orgId                 String
  /// POSH | GRIEVANCE | OTHER
  kind                  String
  /// PC-<year>-<n>: what members and the report call it; carries no name
  reference             String
  complainantEmployeeId String?
  raisedByUserId        String?
  onBehalf              Boolean  @default(false)
  respondentEmployeeIds Json
  summaryEnc            String
  incidentOn            String
  receivedOn            String
  filingDeadline        String
  extendedTo            String?
  extensionReason       String?
  inquiryDue            String
  inquiryClosedOn       String?
  reportDue             String?
  reportOn              String?
  actionDue             String?
  actionOn              String?
  /// RECEIVED | INQUIRY | REPORT_DUE | ACTION_DUE | CLOSED
  status                String   @default("RECEIVED")
  outcome               String?
  /// [{ userId, why }]: committee members left out by the conflict check
  excluded              Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members  PrivateCaseMember[]
  evidence PrivateCaseEvidence[]

  @@unique([orgId, reference])
  @@index([orgId, status])
}

model PrivateCaseMember {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  caseId    String
  userId    String
  /// PRESIDING | MEMBER | EXTERNAL | OFFICER
  role      String
  createdAt DateTime @default(now())

  case PrivateCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([orgId, userId])
}

model PrivateCaseEvidence {
  id            String   @id @default(cuid())
  accountId     String
  orgId         String
  caseId        String
  titleEnc      String
  mime          String
  size          Int
  dataEnc       String
  addedByUserId String?
  createdAt     DateTime @default(now())

  case PrivateCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([orgId, caseId])
}

/// Every open of a case or its evidence (PRIV-03), shown to the presiding officer.
model PrivateCaseAccess {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  caseId     String
  userId     String
  /// OPEN | EVIDENCE
  what       String
  evidenceId String?
  at         DateTime @default(now())

  @@index([orgId, caseId, at])
}

/// The committee that hears private cases (PRIV-06): POSH_IC or GRIEVANCE.
model CommitteeSetup {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  kind            String
  /// [{ userId, role: PRESIDING|MEMBER|EXTERNAL|OFFICER, gender: FEMALE|MALE|OTHER, external: boolean, termStart, termEnd, name? }]
  members         Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, kind])
}

/// An Add-employee wizard left part-way (People design v1 EMP-02): one person's own, kept 30 days.
model EmployeeDraft {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  step      Int      @default(1)
  label     String?
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, userId])
}

/// A named set of filters on a list or report (CORE-01, RPT-02): the user's own, or shared with everyone who can open that screen.
model SavedView {
  id        String   @id @default(cuid())
  accountId String
  orgId     String
  userId    String
  /// employees | report:<key>
  screen    String
  name      String
  filters   Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, screen])
}

/// What an approved change rested on (TRACE-05), frozen at the decision: the policy
/// versions in force for the person and the evidence with its version. A later
/// policy change never rewrites it.
model DecisionRecord {
  id             String   @id @default(cuid())
  accountId      String
  orgId          String
  requestId      String   @unique
  employeeId     String?
  ruleId         String
  ruleVersion    Int
  /// [{ policyId, versionId, title, category, version, effectiveFrom }]
  policyVersions Json
  /// [{ documentId, title, version }]
  evidence       Json
  decidedAt      DateTime @default(now())

  @@index([orgId, employeeId])
}

/// How long each kind of personal data is kept (PRV-03), with a legal hold that stops any deletion.
model RetentionRule {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  /// PEOPLE_RECORD | DOCUMENTS | PAYROLL | ATTENDANCE | SELFIES | ACCESS_LOG
  dataType        String
  keepYears       Int
  legalHold       Boolean  @default(false)
  holdReason      String?
  basis           String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, dataType])
}

/// Data past its retention, waiting for a person to decide (PRV-03): nothing is deleted without one.
model DeletionReview {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  dataType        String
  entityId        String
  label           String
  dueSince        String
  /// PENDING | APPROVED | KEPT
  status          String    @default("PENDING")
  note            String?
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@unique([orgId, dataType, entityId])
  @@index([orgId, status])
}

/// An external auditor's access (PRV-06): named documents only, from a time until a time, every view logged.
model AuditorGrant {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  userId          String
  purpose         String
  documentIds     Json
  fromAt          DateTime
  untilAt         DateTime
  grantedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([orgId, userId, untilAt])
}

/// Letters the company issues (docs/people/02-PRD.md DOC-04; services/people/letters.ts):
/// offer, appointment, confirmation, increment, relieving, experience, service
/// certificate. Each save is a new version; the newest active one is used, and
/// the issued letter records which version made it.
model LetterTemplate {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  /// OFFER | APPOINTMENT | CONFIRMATION | INCREMENT | RELIEVING | EXPERIENCE | SERVICE_CERT
  kind            String
  name            String
  /// Plain text with {{merge}} fields from the allow-list and {{extra.key}} fields HR fills in when issuing.
  body            String
  version         Int
  active          Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([orgId, kind, version])
  @@index([orgId, kind, active])
}

/// A DPDP data-subject request raised from the portal: see my data, correct
/// it, or erase it. HR answers; the answer is shown back to the person.
model DataRequest {
  id               String    @id @default(cuid())
  accountId        String
  orgId            String
  employeeId       String
  /// ACCESS | CORRECTION | ERASURE | WITHDRAW (consent) | NOMINATE | GRIEVANCE
  type             String
  details          String
  /// PENDING | RESOLVED | REJECTED
  status           String    @default("PENDING")
  resolution       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// Answer by: 30 days, inside the 90 the DPDP Rules allow for grievances.
  dueAt            DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([orgId, status])
  @@index([orgId, employeeId])
}

/// A personal-data breach the company records (DPDP Rules, rule 7): what
/// happened, who is affected, when the affected people were told, and the
/// Data Protection Board's first intimation (without delay) and full report
/// (within 72 hours of becoming aware).
model DataBreach {
  id                 String    @id @default(cuid())
  accountId          String
  orgId              String
  title              String
  description        String
  discoveredAt       DateTime
  occurredFrom       DateTime?
  occurredTo         DateTime?
  /// What kind of data: comma-separated (identity, attendance, location, biometric, payroll, bank, contact).
  categories         String
  employeeIdsJson    String    @default("[]")
  consequences       String
  mitigation         String
  stepsForPeople     String
  /// OPEN | CLOSED
  status             String    @default("OPEN")
  boardIntimatedAt   DateTime?
  boardReportAt      DateTime?
  boardReference     String?
  peopleNotifiedAt   DateTime?
  notifiedCount      Int       @default(0)
  createdByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orgId, status])
}

/// A connection to an HR or payroll tool the company also runs — greytHR,
/// Keka, … — spoken by one adapter (services/hr/adapters). Non-secret
/// settings in configJson; keys and secrets encrypted in secretsEnc and never
/// returned. What it does is declared per connection and only within what
/// the adapter can do.
model HrConnection {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  adapter         String
  name            String
  configJson      String    @default("{}")
  secretsEnc      String?
  enabled         Boolean   @default(false)
  pushPunches     Boolean   @default(true)
  pullEmployees   Boolean   @default(false)
  createEmployees Boolean   @default(false)
  lastRunAt       DateTime?
  lastError       String?
  lastSummary     String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId, enabled])
}

/// What is to be sent to an HR tool and has not been yet, or failed: one row
/// per punch per connection, keyed so a retry never posts twice.
model HrOutbox {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  connectionId  String
  kind          String
  key           String
  payload       String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([connectionId, key])
  @@index([orgId, status, nextAttemptAt])
}

/// What each run did, for the Integrations screen: pulled N people, pushed N punches, or why not.
model HrSyncLog {
  id           String   @id @default(cuid())
  accountId    String
  orgId        String
  connectionId String
  kind         String
  ok           Boolean
  detail       String
  createdAt    DateTime @default(now())

  @@index([orgId, connectionId, createdAt])
}

/// A report that goes out by e-mail on its own: which report, with what
/// filters, how often, to whom. The period is implied by the cadence — a
/// daily one covers yesterday, a weekly one the week just ended, a monthly
/// one the month just ended.
model ReportSchedule {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  reportId        String
  paramsJson      String    @default("{}")
  /// DAILY | WEEKLY | MONTHLY
  cadence         String
  /// 1 = Monday … 7 = Sunday, for WEEKLY
  dayOfWeek       Int?
  /// 1..28, for MONTHLY
  dayOfMonth      Int?
  /// Hour of the day, IST, 0..23
  hour            Int       @default(7)
  recipients      String
  enabled         Boolean   @default(true)
  lastSentAt      DateTime?
  lastError       String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId, enabled])
}

/// The on-site connector: a small service on a customer's network that pulls
/// One employee portal sign-in, on one device (A-33, Batch 5). The token the
/// app holds names this row; every request checks it, so ending a row signs
/// that device out at once. Ends after 30 days unused or 180 days in all.
model PortalSession {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  employeeId    String
  /// "Android app", "Chrome on Windows" — from the user agent, to recognise a device by.
  deviceLabel   String
  userAgent     String?
  ip            String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  @@index([orgId, employeeId, revokedAt])
}

/// LAN-only readers, delivers Tally vouchers and syncs Active Directory, all
/// over HTTPS to CLOR (routes/agent.ts, server/agent). One token per agent,
/// shown once; only its hash is kept.
model SiteAgent {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  name            String
  tokenHash       String    @unique
  tokenPrefix     String
  /// Tally host/port/company and LDAP settings that are not secrets, as JSON.
  configJson      String    @default("{}")
  /// LDAP bind password and the SCIM token made for it, encrypted (services/mailer.ts encryptSecret).
  secretsEnc      String?
  /// Secrets the agent has not yet fetched (the SCIM token, shown once), encrypted; cleared on delivery.
  pendingEnc      String?
  scimTokenId     String?
  version         String?
  hostname        String?
  lastSeenAt      DateTime?
  lastError       String?
  lastSummary     String?
  isActive        Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId, isActive])
}

/// Work queued for an on-site connector: a Tally voucher to post, and
/// whatever comes next. PENDING → SENT → DONE | FAILED.
model AgentJob {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  agentId         String
  /// TALLY_XML
  kind            String
  payloadJson     String
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  result          String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  sentAt          DateTime?
  doneAt          DateTime?

  @@index([agentId, status])
  @@index([orgId, createdAt])
}

/// Every change to an attendance day: what it was, what it became, who or
/// what changed it. Days are overwritten in place, so this is the only way to
/// answer "why does this day say what it says" after the fact.
model AttendanceRecordHistory {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  date       String
  recordId   String?
  /// WRITE | DELETE | VALIDATE | OVERTIME | LEAVE_CANCELLED | BULK
  action     String
  /// The record's source after the change (DEVICE, MANUAL, REQUEST, ...)
  source     String?
  beforeJson String?
  afterJson  String?
  /// A user id, or "reader" / "system" for automatic changes.
  userId     String
  reason     String?
  at         DateTime @default(now())

  @@index([orgId, employeeId, date])
  @@index([accountId, orgId, at])
}

/// What a month looked like when it was closed: the figures Payroll takes.
/// A reopen and close makes a new version; old versions are kept.
model AttendanceMonthSnapshot {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  month           String
  version         Int
  rowsJson        String
  readinessJson   String
  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([orgId, month, version])
  @@index([accountId, orgId])
}

/// Who owns an attendance exception and where it stands. The exception itself
/// is worked out from the data each time; this row only holds the handling.
model AttendanceExceptionState {
  id               String    @id @default(cuid())
  accountId        String
  orgId            String
  /// kind:reference, e.g. MISSING_OUT:<recordId>
  key              String
  kind             String
  /// OPEN | IN_PROGRESS | RESOLVED | IGNORED
  status           String    @default("OPEN")
  assigneeUserId   String?
  note             String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([orgId, key])
  @@index([accountId, orgId, status])
}

/// Each saved version of the company's attendance rules.
model AttendanceRuleVersion {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  version         Int
  rulesJson       String
  changedByUserId String
  createdAt       DateTime @default(now())

  @@unique([orgId, version])
  @@index([accountId, orgId])
}

/// One batch of punches arriving from a reader, connector or file, with a
/// trace id the response and logs carry.
/// Every line a reader or connector sent that became a punch, and every one
/// that was refused or set aside, kept as it came: the original (the line, or
/// the vendor's own event JSON), a SHA-256 of it, the vendor's event id where
/// it has one, and which parser read it. Repeats are only counted (IngestRun).
/// Kept 13 months (services/retention), then deleted.
model ReaderEvent {
  id            String   @id @default(cuid())
  accountId     String
  orgId         String
  deviceId      String
  traceId       String
  channel       String
  /// NEW (became a punch), REJECTED (could not be read), IGNORED (not a punch: a door or a refused attempt).
  outcome       String
  reason        String?
  sourceEventId String?
  pin           String?
  localTime     String?
  original      String
  payloadHash   String
  parser        String
  receivedAt    DateTime @default(now())

  @@index([orgId, deviceId, receivedAt])
  @@index([orgId, payloadHash])
  @@index([receivedAt])
}

model IngestRun {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  deviceId   String?
  /// ADMS | PUSH | PULL | HIKVISION | AGENT | FILE
  channel    String
  traceId    String
  received   Int      @default(0)
  accepted   Int      @default(0)
  duplicates Int      @default(0)
  rejected   Int      @default(0)
  errorsJson String?
  at         DateTime @default(now())

  @@index([orgId, deviceId, at])
  @@index([accountId, orgId, at])
}

/// Each time a scheduled report was sent, or failed to send.
model ReportRun {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  scheduleId String
  at         DateTime @default(now())
  ok         Boolean
  rows       Int      @default(0)
  recipients String
  error      String?

  @@index([orgId, scheduleId, at])
}

/// A phone punch the server refused: outside every work site, a rough
/// location, too soon after the last one. Kept so HR can see attempts that
/// never became punches (accepted punches are DevicePunch rows).
model PhonePunchAttempt {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  at         DateTime @default(now())
  /// OUTSIDE | ROUGH_LOCATION | NO_LOCATION | NO_SITE | TOO_SOON | BAD_PHOTO | PHONE_OFF
  code       String
  message    String
  latitude   Float?
  longitude  Float?
  accuracyM  Float?

  @@index([orgId, at])
  @@index([orgId, employeeId, at])
}

/// An employee's own check of their month (Attendance app "Confirm my month"):
/// CONFIRMED, or DISPUTED with what is wrong. Kept with how many items were
/// still open when they did it; HR sees it at month close.
model AttendanceMonthConfirmation {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  month      String /// YYYY-MM
  status     String /// CONFIRMED | DISPUTED
  note       String?
  unresolved Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, employeeId, month])
  @@index([orgId, month])
}

/// Overtime approval or comp-off, asked for by an employee for one day.
/// OVERTIME: approve the overtime recorded that day. COMP_OFF: work on a weekly
/// off or holiday becomes days of the company's comp-off leave type.
model OvertimeRequest {
  id                  String    @id @default(cuid())
  accountId           String
  orgId               String
  employeeId          String
  date                String /// YYYY-MM-DD
  kind                String /// OVERTIME | COMP_OFF
  minutes             Int       @default(0)
  days                Float     @default(0)
  reason              String
  status              String    @default("PENDING")
  managerApprovedAt   DateTime?
  managerApprovedById String?
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([orgId, status])
  @@index([orgId, employeeId, date])
}

/// The recycle bin (services/recycleBin.ts): a deleted row, kept whole with
/// what went with it, until it is restored or `purgeAfter` passes.
model DeletedItem {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  kind            String
  entityId        String
  label           String
  snapshot        Json
  deletedByUserId String
  deletedAt       DateTime @default(now())
  purgeAfter      DateTime

  @@index([orgId, deletedAt])
  @@index([purgeAfter])
}

/// Employment history (services/people/employmentHistory.ts): every change to
/// where and how someone works — joined, moved, promoted, new manager, left,
/// rehired — with the date it takes effect, where it came from, who made it,
/// before and after, and what it means for payroll. Append-only.
model EmploymentEvent {
  id               String   @id @default(cuid())
  accountId        String
  orgId            String
  employeeId       String
  /// JOINED, CHANGED, TRANSFERRED, LEFT, REHIRED
  kind             String
  /// The field that changed (departmentId, jobPositionId, state…); null for JOINED / LEFT / REHIRED.
  field            String?
  fromId           String?
  toId             String?
  /// Names as they were when it happened, so history reads right after a rename.
  fromLabel        String?
  toLabel          String?
  /// YYYY-MM-DD the change counts from.
  effectiveDate    String
  /// FORM, TRANSFER, RESIGNATION, REHIRE, IMPORT
  source           String
  note             String?
  payrollImpact    String?
  recordedByUserId String?
  createdAt        DateTime @default(now())

  @@index([orgId, employeeId, effectiveDate])
}

/// One stint of employment (services/people/episodes.ts): from joining to
/// leaving. A rejoin opens the next stint and keeps the earlier ones, so
/// service history survives; the employee id never changes.
model EmploymentEpisode {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  employeeId String
  /// 1 for the first stint, then 2, 3…
  seq        Int
  startDate  String
  endDate    String?
  /// RESIGNED | TERMINATED | RETIRED | ABSCONDED | CONTRACT_ENDED | DECEASED
  endType    String?
  endReason  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, seq])
  @@index([orgId, employeeId])
}

/// Every write to a person, with before and after (services/people/changeLog.ts;
/// docs/people/02-PRD.md FND-04). Written in the same transaction as the change,
/// so neither exists without the other. Append-only: a trigger refuses UPDATE
/// and DELETE except under the bypass the retention job sets. Sensitive fields
/// are logged as changed, without their values.
model ChangeLog {
  id            String   @id @default(cuid())
  accountId     String
  orgId         String
  /// "Employee" | "Document" | "Policy" | …
  entity        String
  entityId      String
  employeeId    String?
  field         String
  before        String?
  after         String?
  redacted      Boolean  @default(false)
  reason        String?
  /// FORM | IMPORT | APPROVAL | API | SYSTEM | SELF_SERVICE | SCHEDULED | HIRE
  source        String
  actorUserId   String?
  correlationId String
  requestId     String?
  decisionId    String?
  at            DateTime @default(now())

  @@index([orgId, entity, entityId, at])
  @@index([orgId, employeeId, at])
  @@index([correlationId])
}

/// Events other apps and webhooks consume (services/people/outbox.ts; FND-05).
/// Written in the change's transaction, delivered by a worker, named with a
/// version: people.employee.created.v1. A consumer that sees an eventId twice
/// acts once.
model OutboxEvent {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  name          String
  employeeId    String?
  correlationId String
  payload       Json
  occurredAt    DateTime  @default(now())
  deliveredAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?

  @@index([orgId, deliveredAt, nextAttemptAt])
  @@index([orgId, employeeId, occurredAt])
}

/// The company in law (docs/people/02-PRD.md FND-07): the registered entity
/// its establishments belong to. Identifiers are masked when shown.
model LegalEntity {
  id          String   @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  description String?
  pan         String?
  cin         String?
  address     String?
  isActive    Boolean  @default(true)
  createdByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  establishments Establishment[]

  @@unique([orgId, name])
}

/// A place of work in law: a shop, factory, office, site or warehouse in one
/// state. The state decides which rules apply to the people there; a person's
/// work state is their establishment's, never their home address (review R-07).
model Establishment {
  id            String   @id @default(cuid())
  accountId     String
  orgId         String
  legalEntityId String?
  name          String
  description   String?
  /// SHOP | FACTORY | OFFICE | SITE | WAREHOUSE
  kind          String   @default("OFFICE")
  /// The state, as the company writes it: "Karnataka".
  state         String?
  address       String?
  /// Registrations as JSON: [{ type: "SE_REG", number, validTill }]
  registrations Json?
  /// Whether the employer keeps employees' original documents here. Refused where the state forbids it (DOC-07: Karnataka).
  holdsOriginals Boolean @default(false)
  isActive      Boolean  @default(true)
  createdByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)

  @@unique([orgId, name])
  @@index([orgId, state])
}

/// A change to someone's job dated in the future (FND-02): stored here, shown
/// on the record as "Changes on <date>", applied on that day by a job, once.
model ScheduledChange {
  id            String   @id @default(cuid())
  accountId     String
  orgId         String
  employeeId    String
  field         String
  fromValue     String?
  toValue       String?
  fromLabel     String?
  toLabel       String?
  effectiveOn   String
  /// PENDING | APPLIED | CANCELLED
  status        String   @default("PENDING")
  reason        String?
  requestId     String?
  requestedByUserId String?
  correlationId String
  appliedAt     DateTime?
  appliedRunId  String?
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId, status, effectiveOn])
  @@index([orgId, employeeId, status])
}

/// The identifiers People keeps about a person (docs/people/02-PRD.md CORE-04):
/// never the full Aadhaar (UIDAI circular 14/2025: last four digits only),
/// and never PAN, UAN, ESIC or bank details, which are Payroll's and are read
/// from there masked. Shown masked; a reveal needs the Statutory Details
/// grant and a fresh authenticator code, and is written to AccessLog.
model EmployeeIdentity {
  id                String   @id @default(cuid())
  accountId         String
  orgId             String
  employeeId        String   @unique
  aadhaarLast4      String?
  passportNumber    String?
  passportExpiry    String?
  workPermitNumber  String?
  workPermitExpiry  String?
  /// WORKER | SUPERVISOR | MANAGER | APPRENTICE | CONTRACT (what the labour codes call them)
  statutoryCategory String?
  categoryFrom      String?
  updatedByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orgId, employeeId])
}

/// Who looked at what (PRV-07): every reveal of a statutory value, every open
/// of a confidential document or a private case. Append-only.
model AccessLog {
  id         String   @id @default(cuid())
  accountId  String
  orgId      String
  /// STATUTORY | DOC_CONFIDENTIAL | CASE
  what       String
  entityId   String
  employeeId String?
  field      String?
  userId     String
  at         DateTime @default(now())

  @@index([orgId, employeeId, at])
  @@index([orgId, userId, at])
}

/// Approval rules (docs/people/02-PRD.md APR-02): steps in order, each with
/// who decides, an optional condition, a due time and what happens when it
/// is overdue. Versioned: editing writes a new version and requests keep the
/// one they were submitted under.
model ApprovalRule {
  id          String   @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  /// PROFILE_CHANGE | JOB_CHANGE | LEAVING | DOCUMENT_REQUEST | LETTER_REQUEST | POLICY_PUBLISH | DESK_ESCALATION | SEAT_REQUEST | PROBATION
  requestType String
  version     Int      @default(1)
  active      Boolean  @default(true)
  /// [{ order, approver: { kind: MANAGER | MANAGER_OF_MANAGER | USER | ROLE | HR, id? }, condition?: { field, op: changed | eq | ne, value? }, dueDays, overdue: { action: REMIND | HAND_ON, to?: { kind, id? } } }]
  steps       Json
  createdByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, requestType, version])
  @@index([orgId, requestType, active])
}

/// A request waiting for decisions (APR-01): what is asked, under which rule
/// version, where it stands. Approving the last step has the effect the
/// request type names (services/people/approvals/engine.ts).
model ApprovalRequest {
  id                String   @id @default(cuid())
  accountId         String
  orgId             String
  requestType       String
  subjectEmployeeId String?
  requesterUserId   String
  ruleId            String
  ruleVersion       Int
  title             String
  payload           Json
  /// DRAFT | WAITING | APPROVED | REJECTED | WITHDRAWN | MORE_INFO
  status            String   @default("WAITING")
  currentStep       Int      @default(1)
  idempotencyKey    String?
  decisionId        String?
  outcome           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  steps ApprovalStep[]

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status, createdAt])
  @@index([orgId, subjectEmployeeId])
  @@index([orgId, requesterUserId])
}

/// One step of a request: who may decide it (resolved when the step opened,
/// stand-ins included), when it is due, and what they decided.
model ApprovalStep {
  id               String    @id @default(cuid())
  accountId        String
  orgId            String
  requestId        String
  order            Int
  /// Who may decide: the resolved people, as user ids.
  candidateUserIds Json
  approverUserId   String?
  standInForUserId String?
  dueAt            DateTime
  /// WAITING | APPROVED | REJECTED | MORE_INFO | HANDED_ON | SKIPPED | WITHDRAWN
  status           String    @default("WAITING")
  comment          String?
  decidedByUserId  String?
  decidedAt        DateTime?
  remindedAt       DateTime?
  createdAt        DateTime  @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([orgId, status, dueAt])
  @@index([requestId, order])
}

/// Someone standing in for an approver between two dates (APR-04).
model StandIn {
  id            String   @id @default(cuid())
  accountId     String
  orgId         String
  userId        String
  standInUserId String
  fromDate      String
  toDate        String
  createdAt     DateTime @default(now())

  @@index([orgId, userId, fromDate, toDate])
}

/// A probation review (docs/people/02-PRD.md LIFE-03): the period, what was
/// agreed and seen, the recommendation, and the outcome once decided.
model ProbationReview {
  id             String    @id @default(cuid())
  accountId      String
  orgId          String
  employeeId     String
  periodEnd      String
  goals          String?
  observations   String?
  /// CONFIRM | EXTEND | END
  recommendation String?
  newEndDate     String?
  note           String?
  requestId      String?
  /// CONFIRM | EXTEND | END, once decided
  outcome        String?
  decidedByUserId String?
  decidedAt      DateTime?
  reviewedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId, employeeId, createdAt])
}

/// Before day one (docs/people/02-PRD.md LIFE-01; services/people/lifecycle/invites.ts):
/// an invite the joiner opens once, good for fourteen days. What they send is
/// held here until HR checks it and it is written to the record.
model JoinInvite {
  id              String    @id @default(cuid())
  accountId       String
  orgId           String
  employeeId      String
  /// sha256 of the token in the link; the token itself is never stored.
  tokenHash       String    @unique
  /// EMAIL | SMS (no gateway: HR is given the link to send)
  channel         String
  sentTo          String
  /// HR's note to the joiner: what to bring, which policies to read.
  message         String?
  expiresAt       DateTime
  /// SENT | STARTED | RETURNED | CHECKED | EXPIRED
  status          String    @default("SENT")
  /// { fields, declarations, documentIds } as the joiner sent them, until checked.
  submitted       Json?
  startedAt       DateTime?
  returnedAt      DateTime?
  checkedByUserId String?
  checkedAt       DateTime?
  sentByUserId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId, employeeId])
  @@index([orgId, status])
}

/// Joining / leaving checklist a company uses (services/people/checklists.ts).
/// `items`: [{ title, owner, dueDays }], dueDays counted from the joining date
/// or the last working day (negative = before it). No row = CLOR's defaults.
model ChecklistTemplate {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  /// JOINING or LEAVING
  kind            String
  items           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([orgId, kind])
}

/// One thing to do for one person joining or leaving.
model ChecklistTask {
  id           String    @id @default(cuid())
  accountId    String
  orgId        String
  employeeId   String
  /// JOINING | LEAVING | CHANGE | PROBATION
  kind         String
  title        String
  /// The role: HR, MANAGER, PAYROLL, IT, EMPLOYEE
  owner        String
  /// The named person (docs/people/02-PRD.md LIFE-02), resolved when the plan starts; can be reassigned.
  ownerUserId  String?
  dueDate      String?
  sortOrder    Int       @default(0)
  doneAt       DateTime?
  doneByUserId String?
  note         String?
  createdAt    DateTime  @default(now())

  @@index([orgId, employeeId])
  @@index([orgId, doneAt, dueDate])
  @@index([orgId, ownerUserId, doneAt])
}

/// One statutory or company deadline for one period (services/people/compliance.ts):
/// PF ECR for 2026-09, 24Q for 2026-Q2, a licence renewal… with who owns it,
/// whether it is done, the challan or acknowledgement number, and evidence.
model ComplianceTask {
  id            String    @id @default(cuid())
  accountId     String
  orgId         String
  /// PF_ECR, ESIC, TDS_DEPOSIT, TDS_24Q, FORM16, PT, BONUS, POSH_REPORT, or CUSTOM
  code          String
  /// YYYY-MM, YYYY-Qn (financial-year quarter) or YYYY; a cuid for CUSTOM
  period        String
  title         String
  dueDate       String
  /// OPEN, DONE, NOT_APPLICABLE
  status        String    @default("OPEN")
  owner         String?
  reference     String?
  note          String?
  evidenceName  String?
  evidenceMime  String?
  evidenceData  Bytes?
  /// R2 plan: where the evidence is when it is not in `evidenceData` (then empty).
  evidenceKey   String?
  doneAt        DateTime?
  doneByUserId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orgId, code, period])
  @@index([orgId, dueDate])
}

/// HR operational registers. Each kind has a validated payload and status
/// vocabulary in services/people/workspace.ts; no arbitrary client fields.
model PeopleRecord {
  id          String   @id @default(cuid())
  accountId   String
  orgId       String
  kind        String
  title       String
  status      String
  employeeId  String?
  dueDate     String?
  details     Json
  version     Int      @default(1)
  createdBy   String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId, orgId, kind, status])
}

/// A business unit (division / domain) of the company: Retail, Manufacturing, Services.
model BusinessUnit {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  description String?
  isActive    Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// A grade or pay band: L1, L2, M1… Used to group designations and salaries.
model Grade {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  description String?
  isActive    Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}

/// Where a person's cost is booked in the accounts: a project, a plant, a client.
model CostCenter {
  id          String  @id @default(cuid())
  accountId   String
  orgId       String
  name        String
  description String?
  isActive    Boolean @default(true)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, name])
  @@index([accountId, orgId])
}
