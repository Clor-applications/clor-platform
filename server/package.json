{
  "name": "accounting-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "serve": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copyPrismaClients.mjs",
    "agent:build": "esbuild agent/src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-agent/clor-agent.cjs --log-level=warning",
    "agent:check": "tsc -p agent/tsconfig.json --noEmit",
    "agent:sign": "node scripts/sign-agent.mjs",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/payroll/schema.prisma && prisma generate --schema prisma/people/schema.prisma && prisma generate --schema prisma/platform/schema.prisma",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "node scripts/checkDatabaseUrls.mjs && prisma migrate deploy && prisma migrate deploy --schema prisma/payroll/schema.prisma && prisma migrate deploy --schema prisma/people/schema.prisma && prisma migrate deploy --schema prisma/platform/schema.prisma",
    "payroll:generate": "prisma generate --schema prisma/payroll/schema.prisma",
    "payroll:migrate": "prisma migrate dev --schema prisma/payroll/schema.prisma",
    "payroll:deploy": "prisma migrate deploy --schema prisma/payroll/schema.prisma",
    "people:generate": "prisma generate --schema prisma/people/schema.prisma",
    "people:migrate": "prisma migrate dev --schema prisma/people/schema.prisma",
    "people:deploy": "prisma migrate deploy --schema prisma/people/schema.prisma",
    "platform:generate": "prisma generate --schema prisma/platform/schema.prisma",
    "platform:migrate": "prisma migrate dev --schema prisma/platform/schema.prisma",
    "platform:deploy": "prisma migrate deploy --schema prisma/platform/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:ui-qa": "tsx src/scripts/seedUiQa.ts",
    "report:settlement": "tsx src/scripts/settlementReport.ts",
    "integrity:cross-store": "tsx src/scripts/crossStoreIntegrity.ts",
    "files:to-r2": "tsx src/scripts/filesToStore.ts"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.2.0",
    "@prisma/client": "^5.22.0",
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^8.0.3",
    "morgan": "^1.12.0",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.8.8",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
